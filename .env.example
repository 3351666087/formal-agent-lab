# formal-agent-lab configuration (example values only).
# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# --- platform services (single-user local dev profile, loopback only) ---
FAL_DATABASE_URL=postgresql+psycopg://fal:fal@127.0.0.1:5432/fal
FAL_TEMPORAL_ADDRESS=127.0.0.1:7233
FAL_TEMPORAL_NAMESPACE=default
FAL_TEMPORAL_TASK_QUEUE=formal-lab-experiments
FAL_API_HOST=127.0.0.1
FAL_API_PORT=8000

# --- artifact store: "local" or "s3" ---
FAL_ARTIFACT_BACKEND=local
FAL_ARTIFACT_ROOT=./var/artifacts
FAL_S3_ENDPOINT_URL=http://127.0.0.1:8333
FAL_S3_BUCKET=formal-lab-artifacts
FAL_S3_ACCESS_KEY_ID=example-access-key
FAL_S3_SECRET_ACCESS_KEY=example-secret-key
FAL_S3_REGION=us-east-1

# --- optional LLM strategy (OpenAI-compatible Chat Completions) ---
# Leave FAL_LLM_API_KEY empty to run with rule / symbolic strategies only.
FAL_LLM_PROVIDER=openai_compatible
FAL_LLM_BASE_URL=https://api.openai.com/v1
FAL_LLM_API_KEY=
FAL_LLM_MODEL=gpt-5.6-sol
FAL_LLM_TIMEOUT_SECONDS=120
