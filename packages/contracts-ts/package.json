{
  "name": "@formal-lab/contracts",
  "version": "2.0.0",
  "description": "formal-lab-contracts/v2 TypeScript types (and the frozen v1 as namespace V1), generated from contracts/v2 and contracts/v1 (do not edit src/generated*.ts)",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc --noEmit -p tsconfig.json && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2"
  }
}
