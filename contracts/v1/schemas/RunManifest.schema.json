{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Pointer to a large object held by an ArtifactStore (never inlined into events).",
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "format_version": {
          "minLength": 1,
          "title": "Format Version",
          "type": "string"
        },
        "media_type": {
          "minLength": 3,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "description": "object location, e.g. file://… or s3://bucket/key",
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "media_type",
        "size_bytes",
        "digest",
        "format_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_model_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Model Calls"
        },
        "max_steps": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Steps"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "max_wall_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Wall Seconds"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "BudgetUsage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "model_calls": {
          "default": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "steps": {
          "default": 0,
          "title": "Steps",
          "type": "integer"
        },
        "wall_seconds": {
          "default": 0.0,
          "title": "Wall Seconds",
          "type": "number"
        }
      },
      "title": "BudgetUsage",
      "type": "object"
    },
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "EnvironmentSpec": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "plugin": {
          "$ref": "#/$defs/PluginRef"
        }
      },
      "required": [
        "plugin"
      ],
      "title": "EnvironmentSpec",
      "type": "object"
    },
    "Extension": {
      "additionalProperties": false,
      "description": "Namespaced, versioned extension payload. `schema_id` names the JSON Schema that validates `data`.",
      "properties": {
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "schema_id": {
          "minLength": 1,
          "title": "Schema Id",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "schema_id",
        "data"
      ],
      "title": "Extension",
      "type": "object"
    },
    "ModelRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "package_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$",
          "title": "Package Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "package_id",
        "version",
        "digest"
      ],
      "title": "ModelRef",
      "type": "object"
    },
    "Objective": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "metric_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Id"
        },
        "property_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Property Id"
        }
      },
      "title": "Objective",
      "type": "object"
    },
    "Participant": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$",
          "title": "Actor Id",
          "type": "string"
        },
        "role": {
          "default": "operator",
          "title": "Role",
          "type": "string"
        },
        "strategy": {
          "$ref": "#/$defs/StrategySpec"
        }
      },
      "required": [
        "actor_id",
        "strategy"
      ],
      "title": "Participant",
      "type": "object"
    },
    "PlatformInfo": {
      "additionalProperties": false,
      "properties": {
        "source_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Revision"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "title": "PlatformInfo",
      "type": "object"
    },
    "PluginInterface": {
      "enum": [
        "MODEL_FRONTEND",
        "PLANNER",
        "VERIFIER",
        "ENVIRONMENT",
        "EVALUATOR",
        "ARTIFACT_STORE"
      ],
      "title": "PluginInterface",
      "type": "string"
    },
    "PluginPin": {
      "additionalProperties": false,
      "properties": {
        "descriptor_digest": {
          "$ref": "#/$defs/Digest"
        },
        "interface": {
          "$ref": "#/$defs/PluginInterface"
        },
        "interface_version": {
          "title": "Interface Version",
          "type": "string"
        },
        "plugin_id": {
          "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*(/[a-z0-9]+([.-][a-z0-9]+)*)?$",
          "title": "Plugin Id",
          "type": "string"
        },
        "role": {
          "description": "environment / strategy:<actor> / verifier / evaluator / model_frontend",
          "title": "Role",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "role",
        "plugin_id",
        "version",
        "interface",
        "interface_version",
        "descriptor_digest"
      ],
      "title": "PluginPin",
      "type": "object"
    },
    "PluginRef": {
      "additionalProperties": false,
      "properties": {
        "plugin_id": {
          "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*(/[a-z0-9]+([.-][a-z0-9]+)*)?$",
          "title": "Plugin Id",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "plugin_id",
        "version"
      ],
      "title": "PluginRef",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "CREATED",
        "QUEUED",
        "RUNNING",
        "PAUSING",
        "PAUSED",
        "CANCELLING",
        "CANCELLED",
        "SUCCEEDED",
        "FAILED",
        "BUDGET_EXHAUSTED"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "ScenarioManifest": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "contract_version": {
          "const": "formal-lab-contracts/v1",
          "default": "formal-lab-contracts/v1",
          "title": "Contract Version",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentSpec"
        },
        "extensions": {
          "description": "namespaced extension slots; keys are reverse-DNS namespaces, formal-lab.core.* is reserved",
          "patternProperties": {
            "^[a-z0-9]+(\\.[a-z0-9_-]+)+$": {
              "$ref": "#/$defs/Extension"
            }
          },
          "propertyNames": {
            "not": {
              "pattern": "^formal[-_]lab\\.core"
            },
            "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+)+$"
          },
          "title": "Extensions",
          "type": "object"
        },
        "model": {
          "$ref": "#/$defs/ModelRef"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "objectives": {
          "items": {
            "$ref": "#/$defs/Objective"
          },
          "title": "Objectives",
          "type": "array"
        },
        "participants": {
          "items": {
            "$ref": "#/$defs/Participant"
          },
          "minItems": 1,
          "title": "Participants",
          "type": "array"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "scenario_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$",
          "title": "Scenario Id",
          "type": "string"
        },
        "seed": {
          "default": 0,
          "title": "Seed",
          "type": "integer"
        },
        "stop_conditions": {
          "items": {
            "$ref": "#/$defs/StopCondition"
          },
          "title": "Stop Conditions",
          "type": "array"
        }
      },
      "required": [
        "scenario_id",
        "name",
        "model",
        "environment",
        "participants",
        "budget"
      ],
      "title": "ScenarioManifest",
      "type": "object"
    },
    "StopCondition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/StopConditionKind"
        },
        "property_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Property Id"
        }
      },
      "required": [
        "kind"
      ],
      "title": "StopCondition",
      "type": "object"
    },
    "StopConditionKind": {
      "enum": [
        "GOAL_REACHED",
        "INVARIANT_VIOLATED",
        "NO_APPLICABLE_ACTION"
      ],
      "title": "StopConditionKind",
      "type": "string"
    },
    "StrategySpec": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "plugin": {
          "$ref": "#/$defs/PluginRef"
        }
      },
      "required": [
        "plugin"
      ],
      "title": "StrategySpec",
      "type": "object"
    }
  },
  "$id": "https://formal-lab.dev/contracts/v1/RunManifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "budget_usage": {
      "$ref": "#/$defs/BudgetUsage"
    },
    "config": {
      "additionalProperties": true,
      "title": "Config",
      "type": "object"
    },
    "contract_version": {
      "const": "formal-lab-contracts/v1",
      "default": "formal-lab-contracts/v1",
      "title": "Contract Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "extensions": {
      "description": "namespaced extension slots; keys are reverse-DNS namespaces, formal-lab.core.* is reserved",
      "patternProperties": {
        "^[a-z0-9]+(\\.[a-z0-9_-]+)+$": {
          "$ref": "#/$defs/Extension"
        }
      },
      "propertyNames": {
        "not": {
          "pattern": "^formal[-_]lab\\.core"
        },
        "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+)+$"
      },
      "title": "Extensions",
      "type": "object"
    },
    "matrix_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Matrix Id"
    },
    "model": {
      "$ref": "#/$defs/ModelRef"
    },
    "participants": {
      "description": "effective per-actor strategy (after overrides)",
      "items": {
        "$ref": "#/$defs/Participant"
      },
      "title": "Participants",
      "type": "array"
    },
    "platform": {
      "$ref": "#/$defs/PlatformInfo"
    },
    "plugins": {
      "items": {
        "$ref": "#/$defs/PluginPin"
      },
      "title": "Plugins",
      "type": "array"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scenario": {
      "$ref": "#/$defs/ScenarioManifest",
      "description": "scenario snapshot as it was when the run was created"
    },
    "scenario_digest": {
      "$ref": "#/$defs/Digest"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "source_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "run this one re-runs (lineage)",
      "title": "Source Run Id"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "status_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status Reason"
    }
  },
  "required": [
    "run_id",
    "project_id",
    "created_at",
    "scenario",
    "scenario_digest",
    "model",
    "plugins",
    "participants",
    "budget",
    "seed",
    "status",
    "platform"
  ],
  "title": "RunManifest",
  "type": "object"
}
