{
  "$defs": {
    "Aggregation": {
      "enum": [
        "MEAN",
        "SUM",
        "MEDIAN",
        "MIN",
        "MAX",
        "RATE"
      ],
      "title": "Aggregation",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Pointer to a large object held by an ArtifactStore (never inlined into events).",
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "format_version": {
          "minLength": 1,
          "title": "Format Version",
          "type": "string"
        },
        "media_type": {
          "minLength": 3,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "description": "object location, e.g. file://… or s3://bucket/key",
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "media_type",
        "size_bytes",
        "digest",
        "format_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ConfidenceInterval": {
      "additionalProperties": false,
      "properties": {
        "high": {
          "title": "High",
          "type": "number"
        },
        "level": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Level",
          "type": "number"
        },
        "low": {
          "title": "Low",
          "type": "number"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "n": {
          "minimum": 1,
          "title": "N",
          "type": "integer"
        }
      },
      "required": [
        "low",
        "high",
        "level",
        "method",
        "n"
      ],
      "title": "ConfidenceInterval",
      "type": "object"
    },
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Reference to something that supports a claim: an event, artifact, check or snapshot.",
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "event",
            "artifact",
            "check",
            "snapshot",
            "operation",
            "model_call"
          ],
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "MetricStatus": {
      "enum": [
        "OK",
        "MISSING",
        "NOT_APPLICABLE",
        "ERROR"
      ],
      "title": "MetricStatus",
      "type": "string"
    }
  },
  "$id": "https://formal-lab.dev/contracts/v1/MetricResult.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aggregation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Aggregation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ci": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConfidenceInterval"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "metric_id": {
      "title": "Metric Id",
      "type": "string"
    },
    "metric_version": {
      "title": "Metric Version",
      "type": "string"
    },
    "missing_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Missing Count"
    },
    "missing_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Missing Reason"
    },
    "sample_size": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "number of runs aggregated (aggregates only)",
      "title": "Sample Size"
    },
    "status": {
      "$ref": "#/$defs/MetricStatus"
    },
    "subject": {
      "description": "run id, or matrix-cell key for aggregates",
      "title": "Subject",
      "type": "string"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Value"
    }
  },
  "required": [
    "metric_id",
    "metric_version",
    "subject",
    "value",
    "status"
  ],
  "title": "MetricResult",
  "type": "object"
}
