{
  "$defs": {
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Digest",
      "type": "object"
    }
  },
  "$id": "https://formal-lab.dev/contracts/v1/ArtifactRef.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Pointer to a large object held by an ArtifactStore (never inlined into events).",
  "properties": {
    "digest": {
      "$ref": "#/$defs/Digest"
    },
    "format_version": {
      "minLength": 1,
      "title": "Format Version",
      "type": "string"
    },
    "media_type": {
      "minLength": 3,
      "title": "Media Type",
      "type": "string"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "uri": {
      "description": "object location, e.g. file://… or s3://bucket/key",
      "minLength": 1,
      "title": "Uri",
      "type": "string"
    }
  },
  "required": [
    "uri",
    "media_type",
    "size_bytes",
    "digest",
    "format_version"
  ],
  "title": "ArtifactRef",
  "type": "object"
}
