{
  "$defs": {
    "ApplyExpr": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "discriminator": {
              "mapping": {
                "add": "#/$defs/ApplyExpr",
                "and": "#/$defs/ApplyExpr",
                "const": "#/$defs/ConstExpr",
                "count": "#/$defs/QuantExpr",
                "eq": "#/$defs/ApplyExpr",
                "exists": "#/$defs/QuantExpr",
                "forall": "#/$defs/QuantExpr",
                "ge": "#/$defs/ApplyExpr",
                "gt": "#/$defs/ApplyExpr",
                "implies": "#/$defs/ApplyExpr",
                "ite": "#/$defs/ApplyExpr",
                "le": "#/$defs/ApplyExpr",
                "lt": "#/$defs/ApplyExpr",
                "max": "#/$defs/ApplyExpr",
                "max_over": "#/$defs/QuantExpr",
                "min": "#/$defs/ApplyExpr",
                "min_over": "#/$defs/QuantExpr",
                "mul": "#/$defs/ApplyExpr",
                "ne": "#/$defs/ApplyExpr",
                "neg": "#/$defs/ApplyExpr",
                "not": "#/$defs/ApplyExpr",
                "or": "#/$defs/ApplyExpr",
                "ref": "#/$defs/RefExpr",
                "sub": "#/$defs/ApplyExpr",
                "sum": "#/$defs/QuantExpr",
                "var": "#/$defs/VarExpr"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ConstExpr"
              },
              {
                "$ref": "#/$defs/VarExpr"
              },
              {
                "$ref": "#/$defs/RefExpr"
              },
              {
                "$ref": "#/$defs/ApplyExpr"
              },
              {
                "$ref": "#/$defs/QuantExpr"
              }
            ]
          },
          "minItems": 1,
          "title": "Args",
          "type": "array"
        },
        "op": {
          "enum": [
            "not",
            "and",
            "or",
            "implies",
            "eq",
            "ne",
            "lt",
            "le",
            "gt",
            "ge",
            "add",
            "sub",
            "mul",
            "neg",
            "min",
            "max",
            "ite"
          ],
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "args"
      ],
      "title": "ApplyExpr",
      "type": "object"
    },
    "ConstExpr": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "enum or entity set of a symbolic value; required when ambiguous",
          "title": "Domain"
        },
        "op": {
          "const": "const",
          "default": "const",
          "title": "Op",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value"
      ],
      "title": "ConstExpr",
      "type": "object"
    },
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "RUN_CREATED",
        "RUN_QUEUED",
        "RUN_STARTED",
        "OBSERVATION",
        "CANDIDATES",
        "ACTION_PROPOSED",
        "CHECK_COMPLETED",
        "ACTION_OUTCOME",
        "EFFECT_COMPARED",
        "STATE_SNAPSHOT",
        "RUN_PAUSING",
        "RUN_PAUSED",
        "RUN_RESUMED",
        "RUN_CANCELLING",
        "RUN_CANCELLED",
        "BUDGET_EXHAUSTED",
        "RUN_SUCCEEDED",
        "RUN_FAILED",
        "METRICS_COMPUTED",
        "LOG",
        "TURN_STARTED",
        "TURN_SKIPPED",
        "OBSERVATION_REQUESTED",
        "PLAN_UPDATED",
        "PLANNER_CHECKPOINT",
        "OPERATION_STATE",
        "OPERATION_RECONCILED",
        "OPERATION_REVIEW",
        "PROBE_SAMPLED",
        "RULE_EVALUATED",
        "SESSION_STATE",
        "RECOVERY",
        "MODEL_REVISION_SUGGESTED",
        "REGRESSION_CASE_CREATED",
        "EXECUTION_DECIDED"
      ],
      "title": "EventType",
      "type": "string"
    },
    "ExecutionStage": {
      "enum": [
        "TURN",
        "OBSERVE",
        "PROPOSE",
        "CHECK",
        "EXECUTE",
        "RECONCILE",
        "PROBE",
        "COMPARE",
        "TERMINATE"
      ],
      "title": "ExecutionStage",
      "type": "string"
    },
    "ModelRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "package_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$",
          "title": "Package Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "package_id",
        "version",
        "digest"
      ],
      "title": "ModelRef",
      "type": "object"
    },
    "QuantExpr": {
      "additionalProperties": false,
      "description": "forall/exists → bool, count → number of satisfying members, sum → sum of an int body,\nmax_over/min_over → largest/smallest int body over the satisfying members (`default` when there is none).",
      "properties": {
        "body": {
          "discriminator": {
            "mapping": {
              "add": "#/$defs/ApplyExpr",
              "and": "#/$defs/ApplyExpr",
              "const": "#/$defs/ConstExpr",
              "count": "#/$defs/QuantExpr",
              "eq": "#/$defs/ApplyExpr",
              "exists": "#/$defs/QuantExpr",
              "forall": "#/$defs/QuantExpr",
              "ge": "#/$defs/ApplyExpr",
              "gt": "#/$defs/ApplyExpr",
              "implies": "#/$defs/ApplyExpr",
              "ite": "#/$defs/ApplyExpr",
              "le": "#/$defs/ApplyExpr",
              "lt": "#/$defs/ApplyExpr",
              "max": "#/$defs/ApplyExpr",
              "max_over": "#/$defs/QuantExpr",
              "min": "#/$defs/ApplyExpr",
              "min_over": "#/$defs/QuantExpr",
              "mul": "#/$defs/ApplyExpr",
              "ne": "#/$defs/ApplyExpr",
              "neg": "#/$defs/ApplyExpr",
              "not": "#/$defs/ApplyExpr",
              "or": "#/$defs/ApplyExpr",
              "ref": "#/$defs/RefExpr",
              "sub": "#/$defs/ApplyExpr",
              "sum": "#/$defs/QuantExpr",
              "var": "#/$defs/VarExpr"
            },
            "propertyName": "op"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ConstExpr"
            },
            {
              "$ref": "#/$defs/VarExpr"
            },
            {
              "$ref": "#/$defs/RefExpr"
            },
            {
              "$ref": "#/$defs/ApplyExpr"
            },
            {
              "$ref": "#/$defs/QuantExpr"
            }
          ],
          "title": "Body"
        },
        "default": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "add": "#/$defs/ApplyExpr",
                  "and": "#/$defs/ApplyExpr",
                  "const": "#/$defs/ConstExpr",
                  "count": "#/$defs/QuantExpr",
                  "eq": "#/$defs/ApplyExpr",
                  "exists": "#/$defs/QuantExpr",
                  "forall": "#/$defs/QuantExpr",
                  "ge": "#/$defs/ApplyExpr",
                  "gt": "#/$defs/ApplyExpr",
                  "implies": "#/$defs/ApplyExpr",
                  "ite": "#/$defs/ApplyExpr",
                  "le": "#/$defs/ApplyExpr",
                  "lt": "#/$defs/ApplyExpr",
                  "max": "#/$defs/ApplyExpr",
                  "max_over": "#/$defs/QuantExpr",
                  "min": "#/$defs/ApplyExpr",
                  "min_over": "#/$defs/QuantExpr",
                  "mul": "#/$defs/ApplyExpr",
                  "ne": "#/$defs/ApplyExpr",
                  "neg": "#/$defs/ApplyExpr",
                  "not": "#/$defs/ApplyExpr",
                  "or": "#/$defs/ApplyExpr",
                  "ref": "#/$defs/RefExpr",
                  "sub": "#/$defs/ApplyExpr",
                  "sum": "#/$defs/QuantExpr",
                  "var": "#/$defs/VarExpr"
                },
                "propertyName": "op"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/ConstExpr"
                },
                {
                  "$ref": "#/$defs/VarExpr"
                },
                {
                  "$ref": "#/$defs/RefExpr"
                },
                {
                  "$ref": "#/$defs/ApplyExpr"
                },
                {
                  "$ref": "#/$defs/QuantExpr"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "max_over/min_over only: value when no member qualifies",
          "title": "Default"
        },
        "domain": {
          "description": "entity set or enum to range over",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Domain",
          "type": "string"
        },
        "op": {
          "enum": [
            "forall",
            "exists",
            "count",
            "sum",
            "max_over",
            "min_over"
          ],
          "title": "Op",
          "type": "string"
        },
        "var": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Var",
          "type": "string"
        },
        "where": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "add": "#/$defs/ApplyExpr",
                  "and": "#/$defs/ApplyExpr",
                  "const": "#/$defs/ConstExpr",
                  "count": "#/$defs/QuantExpr",
                  "eq": "#/$defs/ApplyExpr",
                  "exists": "#/$defs/QuantExpr",
                  "forall": "#/$defs/QuantExpr",
                  "ge": "#/$defs/ApplyExpr",
                  "gt": "#/$defs/ApplyExpr",
                  "implies": "#/$defs/ApplyExpr",
                  "ite": "#/$defs/ApplyExpr",
                  "le": "#/$defs/ApplyExpr",
                  "lt": "#/$defs/ApplyExpr",
                  "max": "#/$defs/ApplyExpr",
                  "max_over": "#/$defs/QuantExpr",
                  "min": "#/$defs/ApplyExpr",
                  "min_over": "#/$defs/QuantExpr",
                  "mul": "#/$defs/ApplyExpr",
                  "ne": "#/$defs/ApplyExpr",
                  "neg": "#/$defs/ApplyExpr",
                  "not": "#/$defs/ApplyExpr",
                  "or": "#/$defs/ApplyExpr",
                  "ref": "#/$defs/RefExpr",
                  "sub": "#/$defs/ApplyExpr",
                  "sum": "#/$defs/QuantExpr",
                  "var": "#/$defs/VarExpr"
                },
                "propertyName": "op"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/ConstExpr"
                },
                {
                  "$ref": "#/$defs/VarExpr"
                },
                {
                  "$ref": "#/$defs/RefExpr"
                },
                {
                  "$ref": "#/$defs/ApplyExpr"
                },
                {
                  "$ref": "#/$defs/QuantExpr"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Where"
        }
      },
      "required": [
        "op",
        "var",
        "domain",
        "body"
      ],
      "title": "QuantExpr",
      "type": "object"
    },
    "RefExpr": {
      "additionalProperties": false,
      "description": "Reads an action parameter or a quantifier-bound variable.",
      "properties": {
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "op": {
          "const": "ref",
          "default": "ref",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "RefExpr",
      "type": "object"
    },
    "Rule": {
      "additionalProperties": false,
      "description": "Typed event–condition–handler rule. The condition is a pure IR expression over the actor's belief state and\nthe rule context parameters; it is type-checked against the model before release.",
      "properties": {
        "condition": {
          "discriminator": {
            "mapping": {
              "add": "#/$defs/ApplyExpr",
              "and": "#/$defs/ApplyExpr",
              "const": "#/$defs/ConstExpr",
              "count": "#/$defs/QuantExpr",
              "eq": "#/$defs/ApplyExpr",
              "exists": "#/$defs/QuantExpr",
              "forall": "#/$defs/QuantExpr",
              "ge": "#/$defs/ApplyExpr",
              "gt": "#/$defs/ApplyExpr",
              "implies": "#/$defs/ApplyExpr",
              "ite": "#/$defs/ApplyExpr",
              "le": "#/$defs/ApplyExpr",
              "lt": "#/$defs/ApplyExpr",
              "max": "#/$defs/ApplyExpr",
              "max_over": "#/$defs/QuantExpr",
              "min": "#/$defs/ApplyExpr",
              "min_over": "#/$defs/QuantExpr",
              "mul": "#/$defs/ApplyExpr",
              "ne": "#/$defs/ApplyExpr",
              "neg": "#/$defs/ApplyExpr",
              "not": "#/$defs/ApplyExpr",
              "or": "#/$defs/ApplyExpr",
              "ref": "#/$defs/RefExpr",
              "sub": "#/$defs/ApplyExpr",
              "sum": "#/$defs/QuantExpr",
              "var": "#/$defs/VarExpr"
            },
            "propertyName": "op"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ConstExpr"
            },
            {
              "$ref": "#/$defs/VarExpr"
            },
            {
              "$ref": "#/$defs/RefExpr"
            },
            {
              "$ref": "#/$defs/ApplyExpr"
            },
            {
              "$ref": "#/$defs/QuantExpr"
            }
          ],
          "title": "Condition"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "observe_paths": {
          "description": "OBSERVE_MORE: locations to request",
          "items": {
            "type": "string"
          },
          "title": "Observe Paths",
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/RuleOutcome"
        },
        "priority": {
          "default": 0,
          "description": "higher first; ties with different outcomes are a CONFLICT",
          "title": "Priority",
          "type": "integer"
        },
        "rule_id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Rule Id",
          "type": "string"
        },
        "trigger": {
          "$ref": "#/$defs/RuleTrigger"
        }
      },
      "required": [
        "rule_id",
        "trigger",
        "condition",
        "outcome",
        "message"
      ],
      "title": "Rule",
      "type": "object"
    },
    "RuleOutcome": {
      "enum": [
        "CONTINUE",
        "OBSERVE_MORE",
        "REPLAN",
        "PAUSE"
      ],
      "title": "RuleOutcome",
      "type": "string"
    },
    "RuleTrigger": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "description": "event types that make the rule evaluate",
          "items": {
            "$ref": "#/$defs/EventType"
          },
          "minItems": 1,
          "title": "Events",
          "type": "array"
        },
        "stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionStage"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "restrict to events of this stage"
        }
      },
      "required": [
        "events"
      ],
      "title": "RuleTrigger",
      "type": "object"
    },
    "VarExpr": {
      "additionalProperties": false,
      "description": "Reads a state variable or a constant table at the given index.",
      "properties": {
        "index": {
          "items": {
            "discriminator": {
              "mapping": {
                "add": "#/$defs/ApplyExpr",
                "and": "#/$defs/ApplyExpr",
                "const": "#/$defs/ConstExpr",
                "count": "#/$defs/QuantExpr",
                "eq": "#/$defs/ApplyExpr",
                "exists": "#/$defs/QuantExpr",
                "forall": "#/$defs/QuantExpr",
                "ge": "#/$defs/ApplyExpr",
                "gt": "#/$defs/ApplyExpr",
                "implies": "#/$defs/ApplyExpr",
                "ite": "#/$defs/ApplyExpr",
                "le": "#/$defs/ApplyExpr",
                "lt": "#/$defs/ApplyExpr",
                "max": "#/$defs/ApplyExpr",
                "max_over": "#/$defs/QuantExpr",
                "min": "#/$defs/ApplyExpr",
                "min_over": "#/$defs/QuantExpr",
                "mul": "#/$defs/ApplyExpr",
                "ne": "#/$defs/ApplyExpr",
                "neg": "#/$defs/ApplyExpr",
                "not": "#/$defs/ApplyExpr",
                "or": "#/$defs/ApplyExpr",
                "ref": "#/$defs/RefExpr",
                "sub": "#/$defs/ApplyExpr",
                "sum": "#/$defs/QuantExpr",
                "var": "#/$defs/VarExpr"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ConstExpr"
              },
              {
                "$ref": "#/$defs/VarExpr"
              },
              {
                "$ref": "#/$defs/RefExpr"
              },
              {
                "$ref": "#/$defs/ApplyExpr"
              },
              {
                "$ref": "#/$defs/QuantExpr"
              }
            ]
          },
          "title": "Index",
          "type": "array"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "op": {
          "const": "var",
          "default": "var",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "VarExpr",
      "type": "object"
    }
  },
  "$id": "https://formal-lab.dev/contracts/v2/RuleSet.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Digest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model": {
      "$ref": "#/$defs/ModelRef",
      "description": "model the rules are written against (checked with it)"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "parent_version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Version"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/Rule"
      },
      "title": "Rules",
      "type": "array"
    },
    "ruleset_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$",
      "title": "Ruleset Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "ruleset_id",
    "version",
    "name",
    "model"
  ],
  "title": "RuleSet",
  "type": "object"
}
