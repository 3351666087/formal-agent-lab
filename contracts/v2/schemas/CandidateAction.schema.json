{
  "$defs": {
    "GroundAction": {
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Action Type",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "action_type"
      ],
      "title": "GroundAction",
      "type": "object"
    },
    "ObservationRequest": {
      "additionalProperties": false,
      "description": "Extra observations that would settle an UNKNOWN verdict (P2-027).",
      "properties": {
        "applicable_completion": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applicable Completion"
        },
        "for_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ground action key the request is about",
          "title": "For Action"
        },
        "inapplicable_completion": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inapplicable Completion"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Paths",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "paths",
        "reason"
      ],
      "title": "ObservationRequest",
      "type": "object"
    },
    "PreconditionVerdict": {
      "enum": [
        "APPLICABLE",
        "INAPPLICABLE",
        "UNKNOWN",
        "UNSUPPORTED"
      ],
      "title": "PreconditionVerdict",
      "type": "string"
    }
  },
  "$id": "https://formal-lab.dev/contracts/v2/CandidateAction.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/GroundAction"
    },
    "belief_applicability": {
      "$ref": "#/$defs/PreconditionVerdict",
      "description": "applicability judged on the actor's observation (unknown facts stay UNKNOWN)"
    },
    "label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label"
    },
    "observation_request": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObservationRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "UNKNOWN: what would settle it (v2)"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "why it is INAPPLICABLE / UNKNOWN (v2)",
      "title": "Reason"
    }
  },
  "required": [
    "action",
    "belief_applicability"
  ],
  "title": "CandidateAction",
  "type": "object"
}
