{
  "$defs": {
    "ActionScope": {
      "additionalProperties": false,
      "description": "Which ground actions a participant may choose (candidates outside the scope are not offered to it).",
      "properties": {
        "action_types": {
          "description": "empty = every action type",
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "type": "string"
          },
          "title": "Action Types",
          "type": "array"
        },
        "params": {
          "description": "parameter → allowed values (unlisted = any)",
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "items": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            }
          },
          "title": "Params",
          "type": "object"
        }
      },
      "title": "ActionScope",
      "type": "object"
    },
    "ActorGoalMode": {
      "enum": [
        "IGNORE",
        "ALL",
        "ANY"
      ],
      "title": "ActorGoalMode",
      "type": "string"
    },
    "ApplyExpr": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "discriminator": {
              "mapping": {
                "add": "#/$defs/ApplyExpr",
                "and": "#/$defs/ApplyExpr",
                "const": "#/$defs/ConstExpr",
                "count": "#/$defs/QuantExpr",
                "eq": "#/$defs/ApplyExpr",
                "exists": "#/$defs/QuantExpr",
                "forall": "#/$defs/QuantExpr",
                "ge": "#/$defs/ApplyExpr",
                "gt": "#/$defs/ApplyExpr",
                "implies": "#/$defs/ApplyExpr",
                "ite": "#/$defs/ApplyExpr",
                "le": "#/$defs/ApplyExpr",
                "lt": "#/$defs/ApplyExpr",
                "max": "#/$defs/ApplyExpr",
                "max_over": "#/$defs/QuantExpr",
                "min": "#/$defs/ApplyExpr",
                "min_over": "#/$defs/QuantExpr",
                "mul": "#/$defs/ApplyExpr",
                "ne": "#/$defs/ApplyExpr",
                "neg": "#/$defs/ApplyExpr",
                "not": "#/$defs/ApplyExpr",
                "or": "#/$defs/ApplyExpr",
                "ref": "#/$defs/RefExpr",
                "sub": "#/$defs/ApplyExpr",
                "sum": "#/$defs/QuantExpr",
                "var": "#/$defs/VarExpr"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ConstExpr"
              },
              {
                "$ref": "#/$defs/VarExpr"
              },
              {
                "$ref": "#/$defs/RefExpr"
              },
              {
                "$ref": "#/$defs/ApplyExpr"
              },
              {
                "$ref": "#/$defs/QuantExpr"
              }
            ]
          },
          "minItems": 1,
          "title": "Args",
          "type": "array"
        },
        "op": {
          "enum": [
            "not",
            "and",
            "or",
            "implies",
            "eq",
            "ne",
            "lt",
            "le",
            "gt",
            "ge",
            "add",
            "sub",
            "mul",
            "neg",
            "min",
            "max",
            "ite"
          ],
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "args"
      ],
      "title": "ApplyExpr",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_model_attempts": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "phase 4A: requests sent to a model endpoint, retries and failed calls included",
          "title": "Max Model Attempts"
        },
        "max_model_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Model Calls"
        },
        "max_steps": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Steps"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "max_wall_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Wall Seconds"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "ConflictPolicy": {
      "enum": [
        "REVALIDATE",
        "REJECT_STALE"
      ],
      "title": "ConflictPolicy",
      "type": "string"
    },
    "ConstExpr": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "enum or entity set of a symbolic value; required when ambiguous",
          "title": "Domain"
        },
        "op": {
          "const": "const",
          "default": "const",
          "title": "Op",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value"
      ],
      "title": "ConstExpr",
      "type": "object"
    },
    "CostTerm": {
      "additionalProperties": false,
      "description": "One additive cost term of an objective level.\n\n- action_cost: `weight` × the declared `cost` of every action taken on the path.\n- state_rate: `weight` × `expr` (int) evaluated on every post-state s_1..s_k of the path.\n- terminal: `weight` × `expr` (int) evaluated on the final state s_k of the path.",
      "properties": {
        "expr": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "add": "#/$defs/ApplyExpr",
                  "and": "#/$defs/ApplyExpr",
                  "const": "#/$defs/ConstExpr",
                  "count": "#/$defs/QuantExpr",
                  "eq": "#/$defs/ApplyExpr",
                  "exists": "#/$defs/QuantExpr",
                  "forall": "#/$defs/QuantExpr",
                  "ge": "#/$defs/ApplyExpr",
                  "gt": "#/$defs/ApplyExpr",
                  "implies": "#/$defs/ApplyExpr",
                  "ite": "#/$defs/ApplyExpr",
                  "le": "#/$defs/ApplyExpr",
                  "lt": "#/$defs/ApplyExpr",
                  "max": "#/$defs/ApplyExpr",
                  "max_over": "#/$defs/QuantExpr",
                  "min": "#/$defs/ApplyExpr",
                  "min_over": "#/$defs/QuantExpr",
                  "mul": "#/$defs/ApplyExpr",
                  "ne": "#/$defs/ApplyExpr",
                  "neg": "#/$defs/ApplyExpr",
                  "not": "#/$defs/ApplyExpr",
                  "or": "#/$defs/ApplyExpr",
                  "ref": "#/$defs/RefExpr",
                  "sub": "#/$defs/ApplyExpr",
                  "sum": "#/$defs/QuantExpr",
                  "var": "#/$defs/VarExpr"
                },
                "propertyName": "op"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/ConstExpr"
                },
                {
                  "$ref": "#/$defs/VarExpr"
                },
                {
                  "$ref": "#/$defs/RefExpr"
                },
                {
                  "$ref": "#/$defs/ApplyExpr"
                },
                {
                  "$ref": "#/$defs/QuantExpr"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expr"
        },
        "kind": {
          "enum": [
            "action_cost",
            "state_rate",
            "terminal"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "weight": {
          "default": 1,
          "title": "Weight",
          "type": "integer"
        }
      },
      "required": [
        "kind"
      ],
      "title": "CostTerm",
      "type": "object"
    },
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "EnvironmentSpec": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "plugin": {
          "$ref": "#/$defs/PluginRef"
        }
      },
      "required": [
        "plugin"
      ],
      "title": "EnvironmentSpec",
      "type": "object"
    },
    "Extension": {
      "additionalProperties": false,
      "description": "Namespaced, versioned extension payload. `schema_id` names the JSON Schema that validates `data`.",
      "properties": {
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "schema_id": {
          "minLength": 1,
          "title": "Schema Id",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "schema_id",
        "data"
      ],
      "title": "Extension",
      "type": "object"
    },
    "GroundAction": {
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Action Type",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "action_type"
      ],
      "title": "GroundAction",
      "type": "object"
    },
    "ModelRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "package_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$",
          "title": "Package Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "package_id",
        "version",
        "digest"
      ],
      "title": "ModelRef",
      "type": "object"
    },
    "NoActionPolicy": {
      "enum": [
        "FAIL",
        "SKIP_ACTOR",
        "END"
      ],
      "title": "NoActionPolicy",
      "type": "string"
    },
    "Objective": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "metric_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Id"
        },
        "property_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Property Id"
        }
      },
      "title": "Objective",
      "type": "object"
    },
    "ObjectiveLevel": {
      "additionalProperties": false,
      "description": "One lexicographic level: minimise (or maximise) the sum of its terms over the path.",
      "properties": {
        "direction": {
          "default": "minimize",
          "enum": [
            "minimize",
            "maximize"
          ],
          "title": "Direction",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "model_objective": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "use the terms of ModelIR.objectives[id]",
          "title": "Model Objective"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/CostTerm"
          },
          "title": "Terms",
          "type": "array"
        },
        "unit": {
          "default": "cost",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "ObjectiveLevel",
      "type": "object"
    },
    "ObjectiveSpec": {
      "additionalProperties": false,
      "description": "What a cost-aware planner optimises (P2-020).\n\nA candidate plan is a path s_0 → … → s_k (k ≤ horizon) that ends in the first state where `goal_property`\nholds. Its value on each level is the sum of the level's terms over that path (see `CostTerm`); levels are\ncompared lexicographically in list order. Costs stop accumulating once the goal holds.",
      "properties": {
        "accumulation": {
          "const": "until_goal",
          "default": "until_goal",
          "title": "Accumulation",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "goal_property": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Goal Property",
          "type": "string"
        },
        "horizon": {
          "maximum": 200,
          "minimum": 1,
          "title": "Horizon",
          "type": "integer"
        },
        "levels": {
          "items": {
            "$ref": "#/$defs/ObjectiveLevel"
          },
          "minItems": 1,
          "title": "Levels",
          "type": "array"
        },
        "objective_id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Objective Id",
          "type": "string"
        }
      },
      "required": [
        "objective_id",
        "levels",
        "goal_property",
        "horizon"
      ],
      "title": "ObjectiveSpec",
      "type": "object"
    },
    "ObservationTiming": {
      "enum": [
        "TURN_START",
        "ROUND_START"
      ],
      "title": "ObservationTiming",
      "type": "string"
    },
    "Participant": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$",
          "title": "Actor Id",
          "type": "string"
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/Budget"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "per-participant budget, counted separately (v2)"
        },
        "goal": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the participant's own goal property (v2)",
          "title": "Goal"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "role": {
          "default": "operator",
          "title": "Role",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActionScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ground actions this participant may choose (v2)"
        },
        "strategy": {
          "$ref": "#/$defs/StrategySpec"
        },
        "view": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParticipantView"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "data this participant's planner receives (phase 3A)"
        }
      },
      "required": [
        "actor_id",
        "strategy"
      ],
      "title": "Participant",
      "type": "object"
    },
    "ParticipantView": {
      "additionalProperties": false,
      "description": "What one participant's planner receives (phase 3A, G4): observed values of locations outside the view are\nwithheld before its belief is built (they count as never observed), and settings are read from its own map\nfirst. The planner never sees the withheld values; the environment and the kernel still work on the truth.",
      "properties": {
        "exclude": {
          "description": "families or paths withheld even if included",
          "items": {
            "type": "string"
          },
          "title": "Exclude",
          "type": "array"
        },
        "include": {
          "description": "location families or paths the planner may see (empty = every location)",
          "items": {
            "type": "string"
          },
          "title": "Include",
          "type": "array"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "settings": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "participant settings, read before the platform settings",
          "title": "Settings",
          "type": "object"
        }
      },
      "title": "ParticipantView",
      "type": "object"
    },
    "PluginRef": {
      "additionalProperties": false,
      "properties": {
        "plugin_id": {
          "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*(/[a-z0-9]+([.-][a-z0-9]+)*)?$",
          "title": "Plugin Id",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "plugin_id",
        "version"
      ],
      "title": "PluginRef",
      "type": "object"
    },
    "QuantExpr": {
      "additionalProperties": false,
      "description": "forall/exists → bool, count → number of satisfying members, sum → sum of an int body,\nmax_over/min_over → largest/smallest int body over the satisfying members (`default` when there is none).",
      "properties": {
        "body": {
          "discriminator": {
            "mapping": {
              "add": "#/$defs/ApplyExpr",
              "and": "#/$defs/ApplyExpr",
              "const": "#/$defs/ConstExpr",
              "count": "#/$defs/QuantExpr",
              "eq": "#/$defs/ApplyExpr",
              "exists": "#/$defs/QuantExpr",
              "forall": "#/$defs/QuantExpr",
              "ge": "#/$defs/ApplyExpr",
              "gt": "#/$defs/ApplyExpr",
              "implies": "#/$defs/ApplyExpr",
              "ite": "#/$defs/ApplyExpr",
              "le": "#/$defs/ApplyExpr",
              "lt": "#/$defs/ApplyExpr",
              "max": "#/$defs/ApplyExpr",
              "max_over": "#/$defs/QuantExpr",
              "min": "#/$defs/ApplyExpr",
              "min_over": "#/$defs/QuantExpr",
              "mul": "#/$defs/ApplyExpr",
              "ne": "#/$defs/ApplyExpr",
              "neg": "#/$defs/ApplyExpr",
              "not": "#/$defs/ApplyExpr",
              "or": "#/$defs/ApplyExpr",
              "ref": "#/$defs/RefExpr",
              "sub": "#/$defs/ApplyExpr",
              "sum": "#/$defs/QuantExpr",
              "var": "#/$defs/VarExpr"
            },
            "propertyName": "op"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ConstExpr"
            },
            {
              "$ref": "#/$defs/VarExpr"
            },
            {
              "$ref": "#/$defs/RefExpr"
            },
            {
              "$ref": "#/$defs/ApplyExpr"
            },
            {
              "$ref": "#/$defs/QuantExpr"
            }
          ],
          "title": "Body"
        },
        "default": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "add": "#/$defs/ApplyExpr",
                  "and": "#/$defs/ApplyExpr",
                  "const": "#/$defs/ConstExpr",
                  "count": "#/$defs/QuantExpr",
                  "eq": "#/$defs/ApplyExpr",
                  "exists": "#/$defs/QuantExpr",
                  "forall": "#/$defs/QuantExpr",
                  "ge": "#/$defs/ApplyExpr",
                  "gt": "#/$defs/ApplyExpr",
                  "implies": "#/$defs/ApplyExpr",
                  "ite": "#/$defs/ApplyExpr",
                  "le": "#/$defs/ApplyExpr",
                  "lt": "#/$defs/ApplyExpr",
                  "max": "#/$defs/ApplyExpr",
                  "max_over": "#/$defs/QuantExpr",
                  "min": "#/$defs/ApplyExpr",
                  "min_over": "#/$defs/QuantExpr",
                  "mul": "#/$defs/ApplyExpr",
                  "ne": "#/$defs/ApplyExpr",
                  "neg": "#/$defs/ApplyExpr",
                  "not": "#/$defs/ApplyExpr",
                  "or": "#/$defs/ApplyExpr",
                  "ref": "#/$defs/RefExpr",
                  "sub": "#/$defs/ApplyExpr",
                  "sum": "#/$defs/QuantExpr",
                  "var": "#/$defs/VarExpr"
                },
                "propertyName": "op"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/ConstExpr"
                },
                {
                  "$ref": "#/$defs/VarExpr"
                },
                {
                  "$ref": "#/$defs/RefExpr"
                },
                {
                  "$ref": "#/$defs/ApplyExpr"
                },
                {
                  "$ref": "#/$defs/QuantExpr"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "max_over/min_over only: value when no member qualifies",
          "title": "Default"
        },
        "domain": {
          "description": "entity set or enum to range over",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Domain",
          "type": "string"
        },
        "op": {
          "enum": [
            "forall",
            "exists",
            "count",
            "sum",
            "max_over",
            "min_over"
          ],
          "title": "Op",
          "type": "string"
        },
        "var": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Var",
          "type": "string"
        },
        "where": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "add": "#/$defs/ApplyExpr",
                  "and": "#/$defs/ApplyExpr",
                  "const": "#/$defs/ConstExpr",
                  "count": "#/$defs/QuantExpr",
                  "eq": "#/$defs/ApplyExpr",
                  "exists": "#/$defs/QuantExpr",
                  "forall": "#/$defs/QuantExpr",
                  "ge": "#/$defs/ApplyExpr",
                  "gt": "#/$defs/ApplyExpr",
                  "implies": "#/$defs/ApplyExpr",
                  "ite": "#/$defs/ApplyExpr",
                  "le": "#/$defs/ApplyExpr",
                  "lt": "#/$defs/ApplyExpr",
                  "max": "#/$defs/ApplyExpr",
                  "max_over": "#/$defs/QuantExpr",
                  "min": "#/$defs/ApplyExpr",
                  "min_over": "#/$defs/QuantExpr",
                  "mul": "#/$defs/ApplyExpr",
                  "ne": "#/$defs/ApplyExpr",
                  "neg": "#/$defs/ApplyExpr",
                  "not": "#/$defs/ApplyExpr",
                  "or": "#/$defs/ApplyExpr",
                  "ref": "#/$defs/RefExpr",
                  "sub": "#/$defs/ApplyExpr",
                  "sum": "#/$defs/QuantExpr",
                  "var": "#/$defs/VarExpr"
                },
                "propertyName": "op"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/ConstExpr"
                },
                {
                  "$ref": "#/$defs/VarExpr"
                },
                {
                  "$ref": "#/$defs/RefExpr"
                },
                {
                  "$ref": "#/$defs/ApplyExpr"
                },
                {
                  "$ref": "#/$defs/QuantExpr"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Where"
        }
      },
      "required": [
        "op",
        "var",
        "domain",
        "body"
      ],
      "title": "QuantExpr",
      "type": "object"
    },
    "RefExpr": {
      "additionalProperties": false,
      "description": "Reads an action parameter or a quantifier-bound variable.",
      "properties": {
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "op": {
          "const": "ref",
          "default": "ref",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "RefExpr",
      "type": "object"
    },
    "ReleaseRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "release_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$",
          "title": "Release Id",
          "type": "string"
        }
      },
      "required": [
        "release_id",
        "digest"
      ],
      "title": "ReleaseRef",
      "type": "object"
    },
    "RuleSetRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "ruleset_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$",
          "title": "Ruleset Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "ruleset_id",
        "version",
        "digest"
      ],
      "title": "RuleSetRef",
      "type": "object"
    },
    "ScenarioManifest": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "contract_version": {
          "const": "formal-lab-contracts/v2",
          "default": "formal-lab-contracts/v2",
          "title": "Contract Version",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "driver": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "semantic driver; default: the one for the profile"
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentSpec"
        },
        "execution_gates": {
          "description": "pre-execution decision plugins (EXECUTION_GATE) consulted in order before every send of an operation (phase 3A); none = phase-2 behaviour",
          "items": {
            "$ref": "#/$defs/StrategySpec"
          },
          "title": "Execution Gates",
          "type": "array"
        },
        "extensions": {
          "description": "namespaced extension slots; keys are reverse-DNS namespaces, formal-lab.core.* is reserved",
          "patternProperties": {
            "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9_-]+)+$": {
              "$ref": "#/$defs/Extension"
            }
          },
          "propertyNames": {
            "not": {
              "pattern": "^formal[-_]lab\\.core"
            },
            "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9_-]+)+$"
          },
          "title": "Extensions",
          "type": "object"
        },
        "model": {
          "$ref": "#/$defs/ModelRef"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "objective": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectiveSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "cost objective for planners and reports (v2)"
        },
        "objectives": {
          "items": {
            "$ref": "#/$defs/Objective"
          },
          "title": "Objectives",
          "type": "array"
        },
        "participants": {
          "items": {
            "$ref": "#/$defs/Participant"
          },
          "minItems": 1,
          "title": "Participants",
          "type": "array"
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReleaseRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "checked model release the scenario runs on (v2)"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "rules": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "event–condition–handler rules to apply (v2)"
        },
        "scenario_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$",
          "title": "Scenario Id",
          "type": "string"
        },
        "seed": {
          "default": 0,
          "title": "Seed",
          "type": "integer"
        },
        "stop_conditions": {
          "description": "v1 stop conditions; used only when `termination` is not given",
          "items": {
            "$ref": "#/$defs/StopCondition"
          },
          "title": "Stop Conditions",
          "type": "array"
        },
        "termination": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerminationPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v2 termination; overrides stop_conditions"
        },
        "turns": {
          "$ref": "#/$defs/TurnPolicy",
          "description": "interleaving of participants (v2)"
        }
      },
      "required": [
        "scenario_id",
        "name",
        "model",
        "environment",
        "participants",
        "budget"
      ],
      "title": "ScenarioManifest",
      "type": "object"
    },
    "StopCondition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/StopConditionKind"
        },
        "property_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Property Id"
        }
      },
      "required": [
        "kind"
      ],
      "title": "StopCondition",
      "type": "object"
    },
    "StopConditionKind": {
      "enum": [
        "GOAL_REACHED",
        "INVARIANT_VIOLATED",
        "NO_APPLICABLE_ACTION"
      ],
      "title": "StopConditionKind",
      "type": "string"
    },
    "StrategySpec": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "plugin": {
          "$ref": "#/$defs/PluginRef"
        }
      },
      "required": [
        "plugin"
      ],
      "title": "StrategySpec",
      "type": "object"
    },
    "TerminationPolicy": {
      "additionalProperties": false,
      "description": "When a run ends. Budget exhaustion always ends it; the rest is configured here (v1 stop conditions map to\n`joint_goal`, `invariants` and `on_no_action=FAIL`).",
      "properties": {
        "actor_goals": {
          "$ref": "#/$defs/ActorGoalMode",
          "default": "IGNORE"
        },
        "invariants": {
          "description": "a violation ends the run as FAILED",
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "type": "string"
          },
          "title": "Invariants",
          "type": "array"
        },
        "joint_goal": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "property whose truth ends the run successfully",
          "title": "Joint Goal"
        },
        "no_progress_limit": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "end with NO_PROGRESS after this many consecutive turns without a state change",
          "title": "No Progress Limit"
        },
        "on_no_action": {
          "$ref": "#/$defs/NoActionPolicy",
          "default": "FAIL"
        }
      },
      "title": "TerminationPolicy",
      "type": "object"
    },
    "TurnMode": {
      "enum": [
        "ROUND_ROBIN",
        "FIXED_TABLE",
        "JOINT_BATCH"
      ],
      "title": "TurnMode",
      "type": "string"
    },
    "TurnPolicy": {
      "additionalProperties": false,
      "description": "Explicit interleaving semantics: exactly one participant acts per logical (global) step.",
      "properties": {
        "batch_timeout_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JOINT_BATCH: wall-clock limit for collecting one round's proposals; members that have not proposed by then are recorded TIMED_OUT and the batch is submitted without them (phase 3A)",
          "title": "Batch Timeout S"
        },
        "conflict_policy": {
          "$ref": "#/$defs/ConflictPolicy",
          "default": "REVALIDATE"
        },
        "mode": {
          "$ref": "#/$defs/TurnMode",
          "default": "ROUND_ROBIN"
        },
        "observation_timing": {
          "$ref": "#/$defs/ObservationTiming",
          "default": "TURN_START"
        },
        "table": {
          "description": "FIXED_TABLE: actor ids in turn order",
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$",
            "type": "string"
          },
          "title": "Table",
          "type": "array"
        }
      },
      "title": "TurnPolicy",
      "type": "object"
    },
    "VarExpr": {
      "additionalProperties": false,
      "description": "Reads a state variable or a constant table at the given index.",
      "properties": {
        "index": {
          "items": {
            "discriminator": {
              "mapping": {
                "add": "#/$defs/ApplyExpr",
                "and": "#/$defs/ApplyExpr",
                "const": "#/$defs/ConstExpr",
                "count": "#/$defs/QuantExpr",
                "eq": "#/$defs/ApplyExpr",
                "exists": "#/$defs/QuantExpr",
                "forall": "#/$defs/QuantExpr",
                "ge": "#/$defs/ApplyExpr",
                "gt": "#/$defs/ApplyExpr",
                "implies": "#/$defs/ApplyExpr",
                "ite": "#/$defs/ApplyExpr",
                "le": "#/$defs/ApplyExpr",
                "lt": "#/$defs/ApplyExpr",
                "max": "#/$defs/ApplyExpr",
                "max_over": "#/$defs/QuantExpr",
                "min": "#/$defs/ApplyExpr",
                "min_over": "#/$defs/QuantExpr",
                "mul": "#/$defs/ApplyExpr",
                "ne": "#/$defs/ApplyExpr",
                "neg": "#/$defs/ApplyExpr",
                "not": "#/$defs/ApplyExpr",
                "or": "#/$defs/ApplyExpr",
                "ref": "#/$defs/RefExpr",
                "sub": "#/$defs/ApplyExpr",
                "sum": "#/$defs/QuantExpr",
                "var": "#/$defs/VarExpr"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ConstExpr"
              },
              {
                "$ref": "#/$defs/VarExpr"
              },
              {
                "$ref": "#/$defs/RefExpr"
              },
              {
                "$ref": "#/$defs/ApplyExpr"
              },
              {
                "$ref": "#/$defs/QuantExpr"
              }
            ]
          },
          "title": "Index",
          "type": "array"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "op": {
          "const": "var",
          "default": "var",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "VarExpr",
      "type": "object"
    }
  },
  "$id": "https://formal-lab.dev/contracts/v2/RegressionCase.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Minimal replayable case from a counterexample or an effect difference (P2-076).",
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/GroundAction"
      },
      "title": "Actions",
      "type": "array"
    },
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$",
      "title": "Case Id",
      "type": "string"
    },
    "compared_paths": {
      "items": {
        "type": "string"
      },
      "title": "Compared Paths",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expected": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ]
      },
      "description": "model prediction for the compared locations",
      "title": "Expected",
      "type": "object"
    },
    "initial_state": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ]
      },
      "title": "Initial State",
      "type": "object"
    },
    "minimized": {
      "default": false,
      "title": "Minimized",
      "type": "boolean"
    },
    "model": {
      "$ref": "#/$defs/ModelRef"
    },
    "observed": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ]
      },
      "description": "what the run observed",
      "title": "Observed",
      "type": "object"
    },
    "origin": {
      "additionalProperties": true,
      "description": "run_id / step / check_id it came from",
      "title": "Origin",
      "type": "object"
    },
    "scenario": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScenarioManifest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    },
    "source": {
      "enum": [
        "COUNTEREXAMPLE",
        "EFFECT_DIFFERENCE"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "source",
    "model",
    "initial_state",
    "actions",
    "expected",
    "observed",
    "compared_paths",
    "created_at"
  ],
  "title": "RegressionCase",
  "type": "object"
}
