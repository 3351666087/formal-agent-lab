            },
            {
              "$ref": "#/$defs/ApplyExpr"
            },
            {
              "$ref": "#/$defs/QuantExpr"
            }
          ],
          "title": "Body"
        },
        "default": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "add": "#/$defs/ApplyExpr",
                  "and": "#/$defs/ApplyExpr",
                  "const": "#/$defs/ConstExpr",
                  "count": "#/$defs/QuantExpr",
                  "eq": "#/$defs/ApplyExpr",
                  "exists": "#/$defs/QuantExpr",
                  "forall": "#/$defs/QuantExpr",
                  "ge": "#/$defs/ApplyExpr",
                  "gt": "#/$defs/ApplyExpr",
                  "implies": "#/$defs/ApplyExpr",
                  "ite": "#/$defs/ApplyExpr",
                  "le": "#/$defs/ApplyExpr",
                  "lt": "#/$defs/ApplyExpr",
                  "max": "#/$defs/ApplyExpr",
                  "max_over": "#/$defs/QuantExpr",
                  "min": "#/$defs/ApplyExpr",
                  "min_over": "#/$defs/QuantExpr",
                  "mul": "#/$defs/ApplyExpr",
                  "ne": "#/$defs/ApplyExpr",
                  "neg": "#/$defs/ApplyExpr",
                  "not": "#/$defs/ApplyExpr",
                  "or": "#/$defs/ApplyExpr",
                  "ref": "#/$defs/RefExpr",
                  "sub": "#/$defs/ApplyExpr",
                  "sum": "#/$defs/QuantExpr",
                  "var": "#/$defs/VarExpr"
                },
                "propertyName": "op"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/ConstExpr"
                },
                {
                  "$ref": "#/$defs/VarExpr"
                },
                {
                  "$ref": "#/$defs/RefExpr"
                },
                {
                  "$ref": "#/$defs/ApplyExpr"
                },
                {
                  "$ref": "#/$defs/QuantExpr"
                }
              ]
            },
            {
              "type": "null"
