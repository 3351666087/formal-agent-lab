            {
              "$ref": "#/$defs/RuleSetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "event–condition–handler rules to apply (v2)"
        },
        "scenario_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$",
          "title": "Scenario Id",
          "type": "string"
        },
        "seed": {
          "default": 0,
          "title": "Seed",
          "type": "integer"
        },
        "stop_conditions": {
          "description": "v1 stop conditions; used only when `termination` is not given",
          "items": {
            "$ref": "#/$defs/StopCondition"
          },
          "title": "Stop Conditions",
          "type": "array"
        },
        "termination": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerminationPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v2 termination; overrides stop_conditions"
        },
        "turns": {
          "$ref": "#/$defs/TurnPolicy",
          "description": "interleaving of participants (v2)"
        }
      },
      "required": [
        "scenario_id",
        "name",
        "model",
        "environment",
        "participants",
        "budget"
      ],
      "title": "ScenarioManifest",
      "type": "object"
    },
    "StopCondition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/StopConditionKind"
        },
        "property_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Property Id"
        }
      },
      "required": [
        "kind"
      ],
      "title": "StopCondition",
      "type": "object"
    },
    "StopConditionKind": {
      "enum": [
        "GOAL_REACHED",
        "INVARIANT_VIOLATED",
        "NO_APPLICABLE_ACTION"
      ],
      "title": "StopConditionKind",
      "type": "string"
    },
    "StrategySpec": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "plugin": {
          "$ref": "#/$defs/PluginRef"
        }
      },
      "required": [
        "plugin"
      ],
      "title": "StrategySpec",
      "type": "object"
    },
    "TerminationPolicy": {
      "additionalProperties": false,
      "description": "When a run ends. Budget exhaustion always ends it; the rest is configured here (v1 stop conditions map to\n`joint_goal`, `invariants` and `on_no_action=FAIL`).",
      "properties": {
        "actor_goals": {
          "$ref": "#/$defs/ActorGoalMode",
          "default": "IGNORE"
        },
        "invariants": {
          "description": "a violation ends the run as FAILED",
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "type": "string"
          },
          "title": "Invariants",
          "type": "array"
        },
        "joint_goal": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "property whose truth ends the run successfully",
          "title": "Joint Goal"
        },
        "no_progress_limit": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "end with NO_PROGRESS after this many consecutive turns without a state change",
          "title": "No Progress Limit"
        },
        "on_no_action": {
          "$ref": "#/$defs/NoActionPolicy",
          "default": "FAIL"
        }
      },
      "title": "TerminationPolicy",
      "type": "object"
    },
    "TerminationReason": {
      "enum": [
        "JOINT_GOAL_REACHED",
        "ACTOR_GOAL_REACHED",
        "ALL_ACTOR_GOALS_REACHED",
        "INVARIANT_VIOLATED",
        "NO_APPLICABLE_ACTION",
        "NO_PROGRESS",
        "BUDGET_EXHAUSTED",
        "ACTOR_BUDGETS_EXHAUSTED",
        "CANCELLED",
        "FAILED",
        "OPERATION_UNRESOLVED"
      ],
      "title": "TerminationReason",
      "type": "string"
    },
    "TurnMode": {
      "enum": [
        "ROUND_ROBIN",
        "FIXED_TABLE"
      ],
      "title": "TurnMode",
      "type": "string"
    },
    "TurnPolicy": {
      "additionalProperties": false,
      "description": "Explicit interleaving semantics: exactly one participant acts per logical (global) step.",
      "properties": {
        "conflict_policy": {
          "$ref": "#/$defs/ConflictPolicy",
          "default": "REVALIDATE"
        },
        "mode": {
          "$ref": "#/$defs/TurnMode",
          "default": "ROUND_ROBIN"
        },
        "observation_timing": {
          "$ref": "#/$defs/ObservationTiming",
          "default": "TURN_START"
        },
        "table": {
          "description": "FIXED_TABLE: actor ids in turn order",
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$",
            "type": "string"
          },
          "title": "Table",
          "type": "array"
        }
      },
      "title": "TurnPolicy",
      "type": "object"
    },
    "VarExpr": {
      "additionalProperties": false,
      "description": "Reads a state variable or a constant table at the given index.",
      "properties": {
        "index": {
          "items": {
            "discriminator": {
              "mapping": {
                "add": "#/$defs/ApplyExpr",
                "and": "#/$defs/ApplyExpr",
                "const": "#/$defs/ConstExpr",
                "count": "#/$defs/QuantExpr",
                "eq": "#/$defs/ApplyExpr",
                "exists": "#/$defs/QuantExpr",
                "forall": "#/$defs/QuantExpr",
                "ge": "#/$defs/ApplyExpr",
                "gt": "#/$defs/ApplyExpr",
                "implies": "#/$defs/ApplyExpr",
                "ite": "#/$defs/ApplyExpr",
                "le": "#/$defs/ApplyExpr",
                "lt": "#/$defs/ApplyExpr",
                "max": "#/$defs/ApplyExpr",
                "max_over": "#/$defs/QuantExpr",
                "min": "#/$defs/ApplyExpr",
                "min_over": "#/$defs/QuantExpr",
                "mul": "#/$defs/ApplyExpr",
                "ne": "#/$defs/ApplyExpr",
                "neg": "#/$defs/ApplyExpr",
                "not": "#/$defs/ApplyExpr",
                "or": "#/$defs/ApplyExpr",
                "ref": "#/$defs/RefExpr",
                "sub": "#/$defs/ApplyExpr",
                "sum": "#/$defs/QuantExpr",
                "var": "#/$defs/VarExpr"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ConstExpr"
              },
              {
                "$ref": "#/$defs/VarExpr"
              },
              {
                "$ref": "#/$defs/RefExpr"
              },
              {
                "$ref": "#/$defs/ApplyExpr"
              },
              {
                "$ref": "#/$defs/QuantExpr"
              }
            ]
          },
          "title": "Index",
          "type": "array"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "op": {
          "const": "var",
          "default": "var",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "VarExpr",
      "type": "object"
    }
  },
