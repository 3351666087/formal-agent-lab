        },
        "objective": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectiveSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "cost objective for planners and reports (v2)"
        },
        "objectives": {
          "items": {
            "$ref": "#/$defs/Objective"
          },
          "title": "Objectives",
          "type": "array"
        },
        "participants": {
          "items": {
            "$ref": "#/$defs/Participant"
          },
