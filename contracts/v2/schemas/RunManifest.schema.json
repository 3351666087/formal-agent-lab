{
  "$defs": {
    "ActionScope": {
      "additionalProperties": false,
      "description": "Which ground actions a participant may choose (candidates outside the scope are not offered to it).",
      "properties": {
        "action_types": {
          "description": "empty = every action type",
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "type": "string"
          },
          "title": "Action Types",
          "type": "array"
        },
        "params": {
          "description": "parameter → allowed values (unlisted = any)",
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "items": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            }
          },
          "title": "Params",
          "type": "object"
        }
      },
      "title": "ActionScope",
      "type": "object"
    },
    "ActorGoalMode": {
      "enum": [
        "IGNORE",
        "ALL",
        "ANY"
      ],
      "title": "ActorGoalMode",
      "type": "string"
    },
    "ApplyExpr": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "discriminator": {
              "mapping": {
                "add": "#/$defs/ApplyExpr",
                "and": "#/$defs/ApplyExpr",
                "const": "#/$defs/ConstExpr",
                "count": "#/$defs/QuantExpr",
                "eq": "#/$defs/ApplyExpr",
                "exists": "#/$defs/QuantExpr",
                "forall": "#/$defs/QuantExpr",
                "ge": "#/$defs/ApplyExpr",
                "gt": "#/$defs/ApplyExpr",
                "implies": "#/$defs/ApplyExpr",
                "ite": "#/$defs/ApplyExpr",
                "le": "#/$defs/ApplyExpr",
                "lt": "#/$defs/ApplyExpr",
                "max": "#/$defs/ApplyExpr",
                "max_over": "#/$defs/QuantExpr",
                "min": "#/$defs/ApplyExpr",
                "min_over": "#/$defs/QuantExpr",
                "mul": "#/$defs/ApplyExpr",
                "ne": "#/$defs/ApplyExpr",
                "neg": "#/$defs/ApplyExpr",
                "not": "#/$defs/ApplyExpr",
                "or": "#/$defs/ApplyExpr",
                "ref": "#/$defs/RefExpr",
                "sub": "#/$defs/ApplyExpr",
                "sum": "#/$defs/QuantExpr",
                "var": "#/$defs/VarExpr"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ConstExpr"
              },
              {
                "$ref": "#/$defs/VarExpr"
              },
              {
                "$ref": "#/$defs/RefExpr"
              },
              {
                "$ref": "#/$defs/ApplyExpr"
              },
              {
                "$ref": "#/$defs/QuantExpr"
              }
            ]
          },
          "minItems": 1,
          "title": "Args",
          "type": "array"
        },
        "op": {
          "enum": [
            "not",
            "and",
            "or",
            "implies",
            "eq",
            "ne",
            "lt",
            "le",
            "gt",
            "ge",
            "add",
            "sub",
            "mul",
            "neg",
            "min",
            "max",
            "ite"
          ],
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "args"
      ],
      "title": "ApplyExpr",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Pointer to a large object held by an ArtifactStore (never inlined into events).",
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "format_version": {
          "minLength": 1,
          "title": "Format Version",
          "type": "string"
        },
        "media_type": {
          "minLength": 3,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "description": "object location, e.g. file://… or s3://bucket/key",
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "media_type",
        "size_bytes",
        "digest",
        "format_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_model_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Model Calls"
        },
        "max_steps": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Steps"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "max_wall_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Wall Seconds"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "BudgetUsage": {
      "additionalProperties": false,
      "description": "Usage counters. `model_calls` counts calls that returned a usable response; `model_attempts` every request\nsent (incl. failures and lost responses); tokens are only what the provider reported — calls without usage data\nare counted in `unreported_calls`, calls whose response was lost in `unconfirmed_calls`.",
      "properties": {
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "model_attempts": {
          "default": 0,
          "title": "Model Attempts",
          "type": "integer"
        },
        "model_calls": {
          "default": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "observation_requests": {
          "default": 0,
          "title": "Observation Requests",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "steps": {
          "default": 0,
          "title": "Steps",
          "type": "integer"
        },
        "unconfirmed_calls": {
          "default": 0,
          "title": "Unconfirmed Calls",
          "type": "integer"
        },
        "unreported_calls": {
          "default": 0,
          "title": "Unreported Calls",
          "type": "integer"
        },
        "wall_seconds": {
          "default": 0.0,
          "title": "Wall Seconds",
          "type": "number"
        }
      },
      "title": "BudgetUsage",
      "type": "object"
    },
    "CapabilityNegotiation": {
      "additionalProperties": false,
      "properties": {
        "compatible": {
          "title": "Compatible",
          "type": "boolean"
        },
        "granted": {
          "items": {
            "type": "string"
          },
          "title": "Granted",
          "type": "array"
        },
        "missing_optional": {
          "items": {
            "type": "string"
          },
          "title": "Missing Optional",
          "type": "array"
        },
        "missing_required": {
          "items": {
            "type": "string"
          },
          "title": "Missing Required",
          "type": "array"
        },
        "plugin_id": {
          "title": "Plugin Id",
          "type": "string"
        },
        "plugin_version": {
          "title": "Plugin Version",
          "type": "string"
        },
        "reasons": {
          "description": "human-readable explanation (v2)",
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "role of the plugin in the run (v2)",
          "title": "Role"
        },
        "verdict": {
          "anyOf": [
            {
              "enum": [
                "SUPPORTED",
                "PARTIAL",
                "UNSUPPORTED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SUPPORTED: all granted; PARTIAL: optional ones missing; UNSUPPORTED (v2)",
          "title": "Verdict"
        }
      },
      "required": [
        "plugin_id",
        "plugin_version",
        "compatible"
      ],
      "title": "CapabilityNegotiation",
      "type": "object"
    },
    "ConflictPolicy": {
      "enum": [
        "REVALIDATE",
        "REJECT_STALE"
      ],
      "title": "ConflictPolicy",
      "type": "string"
    },
    "ConstExpr": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "enum or entity set of a symbolic value; required when ambiguous",
          "title": "Domain"
        },
        "op": {
          "const": "const",
          "default": "const",
          "title": "Op",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value"
      ],
      "title": "ConstExpr",
      "type": "object"
    },
    "CostTerm": {
      "additionalProperties": false,
      "description": "One additive cost term of an objective level.\n\n- action_cost: `weight` × the declared `cost` of every action taken on the path.\n- state_rate: `weight` × `expr` (int) evaluated on every post-state s_1..s_k of the path.\n- terminal: `weight` × `expr` (int) evaluated on the final state s_k of the path.",
      "properties": {
        "expr": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "add": "#/$defs/ApplyExpr",
                  "and": "#/$defs/ApplyExpr",
                  "const": "#/$defs/ConstExpr",
                  "count": "#/$defs/QuantExpr",
                  "eq": "#/$defs/ApplyExpr",
                  "exists": "#/$defs/QuantExpr",
                  "forall": "#/$defs/QuantExpr",
                  "ge": "#/$defs/ApplyExpr",
                  "gt": "#/$defs/ApplyExpr",
                  "implies": "#/$defs/ApplyExpr",
                  "ite": "#/$defs/ApplyExpr",
                  "le": "#/$defs/ApplyExpr",
                  "lt": "#/$defs/ApplyExpr",
                  "max": "#/$defs/ApplyExpr",
                  "max_over": "#/$defs/QuantExpr",
                  "min": "#/$defs/ApplyExpr",
                  "min_over": "#/$defs/QuantExpr",
                  "mul": "#/$defs/ApplyExpr",
                  "ne": "#/$defs/ApplyExpr",
                  "neg": "#/$defs/ApplyExpr",
                  "not": "#/$defs/ApplyExpr",
                  "or": "#/$defs/ApplyExpr",
                  "ref": "#/$defs/RefExpr",
                  "sub": "#/$defs/ApplyExpr",
                  "sum": "#/$defs/QuantExpr",
                  "var": "#/$defs/VarExpr"
                },
                "propertyName": "op"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/ConstExpr"
                },
                {
                  "$ref": "#/$defs/VarExpr"
                },
                {
                  "$ref": "#/$defs/RefExpr"
                },
                {
                  "$ref": "#/$defs/ApplyExpr"
                },
                {
                  "$ref": "#/$defs/QuantExpr"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expr"
        },
        "kind": {
          "enum": [
            "action_cost",
            "state_rate",
            "terminal"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "weight": {
          "default": 1,
          "title": "Weight",
          "type": "integer"
        }
      },
      "required": [
        "kind"
      ],
      "title": "CostTerm",
      "type": "object"
    },
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "EnvironmentSpec": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "plugin": {
          "$ref": "#/$defs/PluginRef"
        }
      },
      "required": [
        "plugin"
      ],
      "title": "EnvironmentSpec",
      "type": "object"
    },
    "Extension": {
      "additionalProperties": false,
      "description": "Namespaced, versioned extension payload. `schema_id` names the JSON Schema that validates `data`.",
      "properties": {
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "schema_id": {
          "minLength": 1,
          "title": "Schema Id",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "schema_id",
        "data"
      ],
      "title": "Extension",
      "type": "object"
    },
    "ModelRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "package_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$",
          "title": "Package Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "package_id",
        "version",
        "digest"
      ],
      "title": "ModelRef",
      "type": "object"
    },
    "NoActionPolicy": {
      "enum": [
        "FAIL",
        "SKIP_ACTOR",
        "END"
      ],
      "title": "NoActionPolicy",
      "type": "string"
    },
    "Objective": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "metric_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Id"
        },
        "property_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Property Id"
        }
      },
      "title": "Objective",
      "type": "object"
    },
    "ObjectiveLevel": {
      "additionalProperties": false,
      "description": "One lexicographic level: minimise (or maximise) the sum of its terms over the path.",
      "properties": {
        "direction": {
          "default": "minimize",
          "enum": [
            "minimize",
            "maximize"
          ],
          "title": "Direction",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "model_objective": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "use the terms of ModelIR.objectives[id]",
          "title": "Model Objective"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/CostTerm"
          },
          "title": "Terms",
          "type": "array"
        },
        "unit": {
          "default": "cost",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "ObjectiveLevel",
      "type": "object"
    },
    "ObjectiveSpec": {
      "additionalProperties": false,
      "description": "What a cost-aware planner optimises (P2-020).\n\nA candidate plan is a path s_0 → … → s_k (k ≤ horizon) that ends in the first state where `goal_property`\nholds. Its value on each level is the sum of the level's terms over that path (see `CostTerm`); levels are\ncompared lexicographically in list order. Costs stop accumulating once the goal holds.",
      "properties": {
        "accumulation": {
          "const": "until_goal",
          "default": "until_goal",
          "title": "Accumulation",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "goal_property": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Goal Property",
          "type": "string"
        },
        "horizon": {
          "maximum": 200,
          "minimum": 1,
          "title": "Horizon",
          "type": "integer"
        },
        "levels": {
          "items": {
            "$ref": "#/$defs/ObjectiveLevel"
          },
          "minItems": 1,
          "title": "Levels",
          "type": "array"
        },
        "objective_id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Objective Id",
          "type": "string"
        }
      },
      "required": [
        "objective_id",
        "levels",
        "goal_property",
        "horizon"
      ],
      "title": "ObjectiveSpec",
      "type": "object"
    },
    "ObservationTiming": {
      "enum": [
        "TURN_START",
        "ROUND_START"
      ],
      "title": "ObservationTiming",
      "type": "string"
    },
    "Participant": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$",
          "title": "Actor Id",
          "type": "string"
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/Budget"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "per-participant budget, counted separately (v2)"
        },
        "goal": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the participant's own goal property (v2)",
          "title": "Goal"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "role": {
          "default": "operator",
          "title": "Role",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActionScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ground actions this participant may choose (v2)"
        },
        "strategy": {
          "$ref": "#/$defs/StrategySpec"
        }
      },
      "required": [
        "actor_id",
        "strategy"
      ],
      "title": "Participant",
      "type": "object"
    },
    "PlatformInfo": {
      "additionalProperties": false,
      "properties": {
        "source_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Revision"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "title": "PlatformInfo",
      "type": "object"
    },
    "PluginInterface": {
      "enum": [
        "MODEL_FRONTEND",
        "PLANNER",
        "VERIFIER",
        "ENVIRONMENT",
        "EVALUATOR",
        "ARTIFACT_STORE",
        "SEMANTIC_DRIVER",
        "PROBE"
      ],
      "title": "PluginInterface",
      "type": "string"
    },
    "PluginPin": {
      "additionalProperties": false,
      "properties": {
        "descriptor_digest": {
          "$ref": "#/$defs/Digest"
        },
        "interface": {
          "$ref": "#/$defs/PluginInterface"
        },
        "interface_version": {
          "title": "Interface Version",
          "type": "string"
        },
        "plugin_id": {
          "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*(/[a-z0-9]+([.-][a-z0-9]+)*)?$",
          "title": "Plugin Id",
          "type": "string"
        },
        "role": {
          "description": "environment / strategy:<actor> / verifier / evaluator / model_frontend",
          "title": "Role",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "role",
        "plugin_id",
        "version",
        "interface",
        "interface_version",
        "descriptor_digest"
      ],
      "title": "PluginPin",
      "type": "object"
    },
    "PluginRef": {
      "additionalProperties": false,
      "properties": {
        "plugin_id": {
          "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*(/[a-z0-9]+([.-][a-z0-9]+)*)?$",
          "title": "Plugin Id",
          "type": "string"
        },
        "version": {
