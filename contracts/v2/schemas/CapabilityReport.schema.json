{
  "$defs": {
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "FeatureSupport": {
      "additionalProperties": false,
      "description": "Whether one feature (a release check, rules, a query kind, statistics …) is available for a model, derived\nfrom the declared capabilities of its semantic driver and of the installed verifiers (phase 3A, G3).",
      "properties": {
        "feature": {
          "description": "e.g. release.type_check, rules, query.goal_reachability",
          "minLength": 1,
          "title": "Feature",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "plugin that provides it (when supported)"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "requires": {
          "description": "capability ids it needs",
          "items": {
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/SupportStatus"
        }
      },
      "required": [
        "feature",
        "status",
        "reason"
      ],
      "title": "FeatureSupport",
      "type": "object"
    },
    "ModelRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "package_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$",
          "title": "Package Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "package_id",
        "version",
        "digest"
      ],
      "title": "ModelRef",
      "type": "object"
    },
    "PluginRef": {
      "additionalProperties": false,
      "properties": {
        "plugin_id": {
          "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*(/[a-z0-9]+([.-][a-z0-9]+)*)?$",
          "title": "Plugin Id",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "plugin_id",
        "version"
      ],
      "title": "PluginRef",
      "type": "object"
    },
    "SupportStatus": {
      "enum": [
        "SUPPORTED",
        "UNSUPPORTED"
      ],
      "title": "SupportStatus",
      "type": "string"
    }
  },
  "$id": "https://formal-lab.dev/contracts/v2/CapabilityReport.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What the platform can do with one model version, feature by feature — never inferred from the payload's\nshape, only from declared capabilities and the public protocols.",
  "properties": {
    "driver": {
      "$ref": "#/$defs/PluginRef"
    },
    "features": {
      "items": {
        "$ref": "#/$defs/FeatureSupport"
      },
      "title": "Features",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/ModelRef"
    },
    "semantic_profile": {
      "title": "Semantic Profile",
      "type": "string"
    }
  },
  "required": [
    "model",
    "semantic_profile",
    "driver",
    "generated_at"
  ],
  "title": "CapabilityReport",
  "type": "object"
}
