{
  "$defs": {
    "PluginRef": {
      "additionalProperties": false,
      "properties": {
        "plugin_id": {
          "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*(/[a-z0-9]+([.-][a-z0-9]+)*)?$",
          "title": "Plugin Id",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "plugin_id",
        "version"
      ],
      "title": "PluginRef",
      "type": "object"
    },
    "RecoveryMode": {
      "enum": [
        "RESEED",
        "SNAPSHOT",
        "SERVICE_RESET",
        "STATE_IMPORT"
      ],
      "title": "RecoveryMode",
      "type": "string"
    },
    "SessionStatus": {
      "enum": [
        "CREATED",
        "STARTING",
        "READY",
        "RESETTING",
        "CLOSED",
        "FAILED"
      ],
      "title": "SessionStatus",
      "type": "string"
    }
  },
  "$id": "https://formal-lab.dev/contracts/v2/EnvironmentSession.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A running environment instance and its lifecycle (P2-050 / P2-062).",
  "properties": {
    "backend": {
      "enum": [
        "PURE_DATA",
        "SERVICE"
      ],
      "title": "Backend",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "endpoint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "base URL of a service backend (loopback / service name)",
      "title": "Endpoint"
    },
    "environment": {
      "$ref": "#/$defs/PluginRef"
    },
    "health": {
      "additionalProperties": true,
      "title": "Health",
      "type": "object"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "owner": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "project_id / run_id / profile",
      "title": "Owner",
      "type": "object"
    },
    "project_label": {
      "description": "ownership label on every resource this session creates",
      "title": "Project Label",
      "type": "string"
    },
    "recovery_modes": {
      "items": {
        "$ref": "#/$defs/RecoveryMode"
      },
      "title": "Recovery Modes",
      "type": "array"
    },
    "revision": {
      "default": 0,
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "session_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$",
      "title": "Session Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/SessionStatus"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "environment",
    "backend",
    "status",
    "project_label",
    "created_at",
    "updated_at"
  ],
  "title": "EnvironmentSession",
  "type": "object"
}
