{
  "$defs": {
    "EventType": {
      "enum": [
        "RUN_CREATED",
        "RUN_QUEUED",
        "RUN_STARTED",
        "OBSERVATION",
        "CANDIDATES",
        "ACTION_PROPOSED",
        "CHECK_COMPLETED",
        "ACTION_OUTCOME",
        "EFFECT_COMPARED",
        "STATE_SNAPSHOT",
        "RUN_PAUSING",
        "RUN_PAUSED",
        "RUN_RESUMED",
        "RUN_CANCELLING",
        "RUN_CANCELLED",
        "BUDGET_EXHAUSTED",
        "RUN_SUCCEEDED",
        "RUN_FAILED",
        "METRICS_COMPUTED",
        "LOG",
        "TURN_STARTED",
        "TURN_SKIPPED",
        "OBSERVATION_REQUESTED",
        "PLAN_UPDATED",
        "PLANNER_CHECKPOINT",
        "OPERATION_STATE",
        "OPERATION_RECONCILED",
        "OPERATION_REVIEW",
        "PROBE_SAMPLED",
        "RULE_EVALUATED",
        "SESSION_STATE",
        "RECOVERY",
        "MODEL_REVISION_SUGGESTED",
        "REGRESSION_CASE_CREATED"
      ],
      "title": "EventType",
      "type": "string"
    },
    "ExecutionStage": {
      "enum": [
        "TURN",
        "OBSERVE",
        "PROPOSE",
        "CHECK",
        "EXECUTE",
        "RECONCILE",
        "PROBE",
        "COMPARE",
        "TERMINATE"
      ],
      "title": "ExecutionStage",
      "type": "string"
    },
    "TurnRef": {
      "additionalProperties": false,
      "description": "Position of one action in the interleaving: global step g, round r, and the actor's own step count.",
      "properties": {
        "actor_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$",
          "title": "Actor Id",
          "type": "string"
        },
        "actor_step": {
          "minimum": 0,
          "title": "Actor Step",
          "type": "integer"
        },
        "global_step": {
          "minimum": 0,
          "title": "Global Step",
          "type": "integer"
        },
        "round": {
          "minimum": 0,
          "title": "Round",
          "type": "integer"
        }
      },
      "required": [
        "global_step",
        "round",
        "actor_id",
        "actor_step"
      ],
      "title": "TurnRef",
      "type": "object"
    }
  },
  "$id": "https://formal-lab.dev/contracts/v2/TraceEvent.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actor Id"
    },
    "causal_parents": {
      "description": "event ids this event was caused by",
      "items": {
        "type": "string"
      },
      "title": "Causal Parents",
      "type": "array"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "logical_step": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Logical Step"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "payload_schema": {
      "description": "schema id of payload, e.g. formal-lab/events/ACTION_PROPOSED@1",
      "title": "Payload Schema",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "seq": {
      "description": "monotonic per-run sequence number, gap-free",
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "stage": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionStage"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "execution stage that emitted it (v2)"
    },
    "turn": {
      "anyOf": [
        {
          "$ref": "#/$defs/TurnRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "turn the event belongs to (v2)"
    },
    "wall_time": {
      "format": "date-time",
      "title": "Wall Time",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "run_id",
    "seq",
    "event_type",
    "wall_time",
    "payload_schema"
  ],
  "title": "TraceEvent",
  "type": "object"
}
