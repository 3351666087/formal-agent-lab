{
  "$id": "https://formal-lab.dev/contracts/v2/ObservationRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Extra observations that would settle an UNKNOWN verdict (P2-027).",
  "properties": {
    "applicable_completion": {
      "anyOf": [
        {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Applicable Completion"
    },
    "for_action": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ground action key the request is about",
      "title": "For Action"
    },
    "inapplicable_completion": {
      "anyOf": [
        {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Inapplicable Completion"
    },
    "paths": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Paths",
      "type": "array"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "paths",
    "reason"
  ],
  "title": "ObservationRequest",
  "type": "object"
}
