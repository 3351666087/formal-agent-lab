{
  "$defs": {
    "AssumptionSetRef": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "#/$defs/PlanBasis",
          "default": "FULLY_OBSERVED"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "digest",
        "count"
      ],
      "title": "AssumptionSetRef",
      "type": "object"
    },
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "GroundAction": {
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Action Type",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "action_type"
      ],
      "title": "GroundAction",
      "type": "object"
    },
    "ModelUsage": {
      "additionalProperties": false,
      "description": "Model usage of one proposal: `model_calls` usable responses, `attempts` requests sent; tokens as reported.",
      "properties": {
        "attempts": {
          "default": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "model_calls": {
          "default": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "unconfirmed_calls": {
          "default": 0,
          "title": "Unconfirmed Calls",
          "type": "integer"
        },
        "unreported_calls": {
          "default": 0,
          "title": "Unreported Calls",
          "type": "integer"
        }
      },
      "title": "ModelUsage",
      "type": "object"
    },
    "ObservationRequest": {
      "additionalProperties": false,
      "description": "Extra observations that would settle an UNKNOWN verdict (P2-027).",
      "properties": {
        "applicable_completion": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applicable Completion"
        },
        "for_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ground action key the request is about",
          "title": "For Action"
        },
        "inapplicable_completion": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inapplicable Completion"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Paths",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "paths",
        "reason"
      ],
      "title": "ObservationRequest",
      "type": "object"
    },
    "PlanBasis": {
      "enum": [
        "FULLY_OBSERVED",
        "ASSUMPTION_BASED",
        "ROBUST"
      ],
      "title": "PlanBasis",
      "type": "string"
    },
    "PlanRef": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Id"
        },
        "plan_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$",
          "title": "Plan Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "plan_id",
        "version"
      ],
      "title": "PlanRef",
      "type": "object"
    },
    "PluginRef": {
      "additionalProperties": false,
      "properties": {
        "plugin_id": {
          "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*(/[a-z0-9]+([.-][a-z0-9]+)*)?$",
          "title": "Plugin Id",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "plugin_id",
        "version"
      ],
      "title": "PluginRef",
      "type": "object"
    },
    "ProposalSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProposalSourceKind"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "model identifier for LLM / LLM_STUB sources",
          "title": "Model"
        },
        "model_call_ids": {
          "items": {
            "type": "string"
          },
          "title": "Model Call Ids",
          "type": "array"
        },
        "strategy": {
          "$ref": "#/$defs/PluginRef"
        }
      },
      "required": [
        "kind",
        "strategy"
      ],
      "title": "ProposalSource",
      "type": "object"
    },
    "ProposalSourceKind": {
      "enum": [
        "RULE",
        "SYMBOLIC",
        "LLM",
        "LLM_STUB",
        "HUMAN",
        "EXTERNAL"
      ],
      "title": "ProposalSourceKind",
      "type": "string"
    },
    "TurnRef": {
      "additionalProperties": false,
      "description": "Position of one action in the interleaving: global step g, round r, and the actor's own step count.",
      "properties": {
        "actor_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$",
          "title": "Actor Id",
          "type": "string"
        },
        "actor_step": {
          "minimum": 0,
          "title": "Actor Step",
          "type": "integer"
        },
        "batch_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JOINT_BATCH: the round's batch (phase 3A)",
          "title": "Batch Id"
        },
        "env_step": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JOINT_BATCH: environment step the batch was applied at (one per batch, phase 3A)",
          "title": "Env Step"
        },
        "global_step": {
          "minimum": 0,
          "title": "Global Step",
          "type": "integer"
        },
        "round": {
          "minimum": 0,
          "title": "Round",
          "type": "integer"
        }
      },
      "required": [
        "global_step",
        "round",
        "actor_id",
        "actor_step"
      ],
      "title": "TurnRef",
      "type": "object"
    }
  },
  "$id": "https://formal-lab.dev/contracts/v2/ActionProposal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/GroundAction"
    },
    "actor_id": {
      "title": "Actor Id",
      "type": "string"
    },
    "assumptions": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssumptionSetRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "what the proposal assumed (v2)"
    },
    "based_on_revision": {
      "description": "observation state_revision the proposal relied on",
      "minimum": 0,
      "title": "Based On Revision",
      "type": "integer"
    },
    "candidates_considered": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidates Considered"
    },
    "observation_request": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObservationRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ask for fresh observations first; `action` is the fallback if none are possible"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "task-plan node this proposal executes (v2)"
    },
    "proposal_id": {
      "title": "Proposal Id",
      "type": "string"
    },
    "rationale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/ProposalSource"
    },
    "step": {
      "minimum": 0,
      "title": "Step",
      "type": "integer"
    },
    "step_id": {
      "title": "Step Id",
      "type": "string"
    },
    "turn": {
      "anyOf": [
        {
          "$ref": "#/$defs/TurnRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "usage": {
      "$ref": "#/$defs/ModelUsage"
    }
  },
  "required": [
    "proposal_id",
    "run_id",
    "step_id",
    "step",
    "actor_id",
    "action",
    "based_on_revision",
    "source"
  ],
  "title": "ActionProposal",
  "type": "object"
}
