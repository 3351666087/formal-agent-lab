{
  "$defs": {
    "GroundAction": {
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Action Type",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "action_type"
      ],
      "title": "GroundAction",
      "type": "object"
    }
  },
  "$id": "https://formal-lab.dev/contracts/v2/AutomaticAction.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An action the environment's own automatic participant took inside a world step (phase 4A) — not a platform\nparticipant's proposal; recorded apart from the batch members.",
  "properties": {
    "action": {
      "$ref": "#/$defs/GroundAction"
    },
    "actor_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$",
      "title": "Actor Id",
      "type": "string"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "status": {
      "enum": [
        "APPLIED",
        "REJECTED"
      ],
      "title": "Status",
      "type": "string"
    },
    "written_paths": {
      "items": {
        "type": "string"
      },
      "title": "Written Paths",
      "type": "array"
    }
  },
  "required": [
    "actor_id",
    "action",
    "status"
  ],
  "title": "AutomaticAction",
  "type": "object"
}
