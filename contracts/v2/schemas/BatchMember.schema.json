{
  "$defs": {
    "BatchMemberStatus": {
      "enum": [
        "PROPOSED",
        "PASSED",
        "ABSENT",
        "TIMED_OUT",
        "CANCELLED"
      ],
      "title": "BatchMemberStatus",
      "type": "string"
    }
  },
  "$id": "https://formal-lab.dev/contracts/v2/BatchMember.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$",
      "title": "Actor Id",
      "type": "string"
    },
    "actor_step": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actor Step"
    },
    "global_step": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "global step of its proposal",
      "title": "Global Step"
    },
    "proposal_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposal Id"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "status": {
      "$ref": "#/$defs/BatchMemberStatus"
    }
  },
  "required": [
    "actor_id",
    "status"
  ],
  "title": "BatchMember",
  "type": "object"
}
