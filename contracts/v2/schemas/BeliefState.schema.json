{
  "$defs": {
    "AssumptionItem": {
      "additionalProperties": false,
      "properties": {
        "as_of_step": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of Step"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "value the plan assumed (null for free UNKNOWN locations)",
          "title": "Value"
        }
      },
      "required": [
        "path",
        "provenance",
        "value"
      ],
      "title": "AssumptionItem",
      "type": "object"
    },
    "AssumptionSet": {
      "additionalProperties": false,
      "description": "Everything a belief-based conclusion assumed beyond fresh observations (P2-025).",
      "properties": {
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "provenance → number of locations",
          "title": "Counts",
          "type": "object"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/AssumptionItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "digest"
      ],
      "title": "AssumptionSet",
      "type": "object"
    },
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "Provenance": {
      "enum": [
        "KNOWN",
        "STALE",
        "UNKNOWN",
        "ASSUMED_INITIAL"
      ],
      "title": "Provenance",
      "type": "string"
    }
  },
  "$id": "https://formal-lab.dev/contracts/v2/BeliefState.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What one participant may plan with: every location has a value, each with its provenance (P2-025).",
  "properties": {
    "actor_id": {
      "title": "Actor Id",
      "type": "string"
    },
    "as_of_step": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "STALE locations: step of the value",
      "title": "As Of Step",
      "type": "object"
    },
    "assumptions": {
      "$ref": "#/$defs/AssumptionSet"
    },
    "free_paths": {
      "description": "locations completion-based checks range over (the observation's unknown items); other non-KNOWN locations are assumed at their value",
      "items": {
        "type": "string"
      },
      "title": "Free Paths",
      "type": "array"
    },
    "provenance": {
      "additionalProperties": {
        "$ref": "#/$defs/Provenance"
      },
      "title": "Provenance",
      "type": "object"
    },
    "state": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ]
      },
      "title": "State",
      "type": "object"
    },
    "step": {
      "minimum": 0,
      "title": "Step",
      "type": "integer"
    },
    "world_revision": {
      "minimum": 0,
      "title": "World Revision",
      "type": "integer"
    }
  },
  "required": [
    "actor_id",
    "step",
    "world_revision",
    "state",
    "provenance",
    "assumptions"
  ],
  "title": "BeliefState",
  "type": "object"
}
