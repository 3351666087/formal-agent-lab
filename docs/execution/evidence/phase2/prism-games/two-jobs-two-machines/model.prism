// two-jobs-two-machines: generated by formal_lab_solver_prism.game.to_prism from org.formal-lab.prism-games/allocation-game@1
// dispatcher assigns jobs, environment slows a machine, machines work (stochastic)
smg

const int K = 3;
const double s = 0.5;
const double p_m1 = 0.9;
const double p_m2 = 0.6;

player dispatcher [asg_a_m1], [asg_a_m2], [asg_b_m1], [asg_b_m2], [asg_a_m1_b_m2], [asg_a_m2_b_m1] endplayer
player environment [slow_m1], [slow_m2], [work] endplayer

formula q_a = (x_a=1 ? p_m1 : (x_a=2 ? p_m2 : 0)) * (sl>0 & sl=x_a ? s : 1);
formula q_b = (x_b=1 ? p_m1 : (x_b=2 ? p_m2 : 0)) * (sl>0 & sl=x_b ? s : 1);

module plant
  t : [0..2] init 0;  // 0 dispatcher, 1 environment, 2 work
  r : [0..K] init 0;
  d_a : bool init false;
  d_b : bool init false;
  x_a : [0..2] init 0;
  x_b : [0..2] init 0;
  sl : [0..2] init 0;

  [asg_a_m1] t=0 & r<K & !d_a -> (x_a'=1) & (x_b'=0) & (t'=1);
  [asg_a_m2] t=0 & r<K & !d_a -> (x_a'=2) & (x_b'=0) & (t'=1);
  [asg_b_m1] t=0 & r<K & !d_b -> (x_a'=0) & (x_b'=1) & (t'=1);
  [asg_b_m2] t=0 & r<K & !d_b -> (x_a'=0) & (x_b'=2) & (t'=1);
  [asg_a_m1_b_m2] t=0 & r<K & !d_a & !d_b -> (x_a'=1) & (x_b'=2) & (t'=1);
  [asg_a_m2_b_m1] t=0 & r<K & !d_a & !d_b -> (x_a'=2) & (x_b'=1) & (t'=1);
  [slow_m1] t=1 -> (sl'=1) & (t'=2);
  [slow_m2] t=1 -> (sl'=2) & (t'=2);
  [work] t=2 -> q_a*q_b : (d_a'=d_a|x_a>0) & (d_b'=d_b|x_b>0) & (x_a'=0) & (x_b'=0) & (sl'=0) & (t'=0) & (r'=r+1)
              + q_a*(1-q_b) : (d_a'=d_a|x_a>0) & (x_a'=0) & (x_b'=0) & (sl'=0) & (t'=0) & (r'=r+1)
              + (1-q_a)*q_b : (d_b'=d_b|x_b>0) & (x_a'=0) & (x_b'=0) & (sl'=0) & (t'=0) & (r'=r+1)
              + (1-q_a)*(1-q_b) : (x_a'=0) & (x_b'=0) & (sl'=0) & (t'=0) & (r'=r+1);
endmodule

label "done" = d_a & d_b;
