  "model_text": "// three-jobs-three-machines: generated by formal_lab_solver_prism.game.to_prism from org.formal-lab.prism-games/allocation-game@1\n// dispatcher assigns jobs, environment slows a machine, machines work (stochastic)\nsmg\n\nconst int K = 4;\nconst double s = 0.4;\nconst double p_m1 = 0.9;\nconst double p_m2 = 0.7;\nconst double p_m3 = 0.5;\n\nplayer dispatcher [asg_a_m1], [asg_a_m2], [asg_a_m3], [asg_b_m1], [asg_b_m2], [asg_b_m3], [asg_c_m1], [asg_c_m2], [asg_c_m3], [asg_a_m1_b_m2], [asg_a_m1_b_m3], [asg_a_m2_b_m1], [asg_a_m2_b_m3], [asg_a_m3_b_m1], [asg_a_m3_b_m2], [asg_a_m1_c_m2], [asg_a_m1_c_m3], [asg_a_m2_c_m1], [asg_a_m2_c_m3], [asg_a_m3_c_m1], [asg_a_m3_c_m2], [asg_b_m1_c_m2], [asg_b_m1_c_m3], [asg_b_m2_c_m1], [asg_b_m2_c_m3], [asg_b_m3_c_m1], [asg_b_m3_c_m2], [asg_a_m1_b_m2_c_m3], [asg_a_m1_b_m3_c_m2], [asg_a_m2_b_m1_c_m3], [asg_a_m2_b_m3_c_m1], [asg_a_m3_b_m1_c_m2], [asg_a_m3_b_m2_c_m1] endplayer\nplayer environment [slow_m1], [slow_m2], [slow_m3], [work] endplayer\n\nformula q_a = (x_a=1 ? p_m1 : (x_a=2 ? p_m2 : (x_a=3 ? p_m3 : 0))) * (sl>0 & sl=x_a ? s : 1);\nformula q_b = (x_b=1 ? p_m1 : (x_b=2 ? p_m2 : (x_b=3 ? p_m3 : 0))) * (sl>0 & sl=x_b ? s : 1);\nformula q_c = (x_c=1 ? p_m1 : (x_c=2 ? p_m2 : (x_c=3 ? p_m3 : 0))) * (sl>0 & sl=x_c ? s : 1);\n\nmodule plant\n  t : [0..2] init 0;  // 0 dispatcher, 1 environment, 2 work\n  r : [0..K] init 0;\n  d_a : bool init false;\n  d_b : bool init false;\n  d_c : bool init false;\n  x_a : [0..3] init 0;\n  x_b : [0..3] init 0;\n  x_c : [0..3] init 0;\n  sl : [0..3] init 0;\n\n  [asg_a_m1] t=0 & r<K & !d_a -> (x_a'=1) & (x_b'=0) & (x_c'=0) & (t'=1);\n  [asg_a_m2] t=0 & r<K & !d_a -> (x_a'=2) & (x_b'=0) & (x_c'=0) & (t'=1);\n  [asg_a_m3] t=0 & r<K & !d_a -> (x_a'=3) & (x_b'=0) & (x_c'=0) & (t'=1);\n  [asg_b_m1] t=0 & r<K & !d_b -> (x_a'=0) & (x_b'=1) & (x_c'=0) & (t'=1);\n  [asg_b_m2] t=0 & r<K & !d_b -> (x_a'=0) & (x_b'=2) & (x_c'=0) & (t'=1);\n  [asg_b_m3] t=0 & r<K & !d_b -> (x_a'=0) & (x_b'=3) & (x