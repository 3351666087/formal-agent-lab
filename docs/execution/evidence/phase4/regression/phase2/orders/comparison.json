  "environments": {
    "formal-lab.env.ir-world": {
      "capabilities": [
        "env.idempotent_step",
        "env.multi_actor",
        "env.observation_delay",
        "env.observe_on_request",
        "env.pure_replayable",
        "env.restore",
        "env.seeded_variation",
        "env.snapshot",
        "env.snapshot_restore",
        "env.truth_overrides",
        "profile.deterministic_finite_v1"
      ],
      "recovery_modes": [
        "RESEED",
        "SNAPSHOT"
      ],
      "deployment_profiles": {
        "all": "in-process"
      }
    },
    "formal-lab.example.orders.service-env": {
      "capabilities": [
        "env.conditional_step",
        "env.current_revision",
        "env.idempotent_step",
        "env.multi_actor",
        "env.observe_on_request",
        "env.persistent_session",
        "env.query_operation",
        "env.reset_session",
        "env.snapshot",
        "env.state_import",
        "profile.deterministic_finite_v1"
      ],
      "recovery_modes": [
        "SERVICE_RESET",
        "STATE_IMPORT"
      ],
      "deployment_profiles": {
        "local-lite": "loopback port started by the dev script or lifecycle manager (127.0.0.1)",
        "local-services": "Compose service `orders` (http://orders:8765 inside the stack)",
        "local-kind": "not provided for this example"
      }
    }
  },
  "probe_metrics": [
    {
      "metric_id": "throughput",
      "unit": "orders/tick",
      "description": "orders completed in the last W logical ticks ÷ W (logical window)"
    },
    {
      "metric_id": "completion_rate",
      "unit": "ratio",
      "description": "completed ÷ arrived orders (to date)"
    },
    {
      "metric_id": "queue_length",
      "unit": "orders",
      "description": "orders waiting in the processing queue now"
    },
    {
      "metric_id": "backlog",
      "unit": "orders",
      "description": "arrived orders not yet processing"
    },
    {
      "metric_id": "latency_ticks",
      "unit": "ticks",
      "description": "mean done_at − arrive_at of orders completed in the window (logical ticks)"
    },
    {
      "metric_id": "op_latency_ms",
      "unit": "ms",
      "description": "median service-side handling time of the last 4·W operations (wall clock)"
    },
    {
      "metric_id": "recovery_seconds",
      "unit": "s",
      "description": "last restart: process start − last committed operation before it (wall clock)"
    }
  ]
}
