   "text": "{\"semantic_profile\":\"deterministic_finite_v1\",\"name\":\"local-order-service\",\"description\":\"Order handling: reserve stock, queue, process on stations, complete; orders keep arriving.\",\"enums\":[{\"name\":\"order_status\",\"values\":[\"pending\",\"submitted\",\"reserved\",\"queued\",\"processing\",\"completed\"],\"description\":null}],\"entity_sets\":[{\"name\":\"orders\",\"members\":[\"o1\",\"o2\",\"o3\",\"o4\",\"o5\",\"o6\"],\"label\":\"订单\",\"description\":null},{\"name\":\"skus\",\"members\":[\"a\",\"b\"],\"label\":\"库存品\",\"description\":null},{\"name\":\"stations\",\"members\":[\"p1\",\"p2\"],\"label\":\"处理工位\",\"description\":null}],\"constants\":[{\"name\":\"sku_of\",\"type\":{\"kind\":\"entity\",\"set\":\"skus\"},\"index\":[\"orders\"],\"value\":{\"default\":null,\"cells\":[{\"index\":[\"o1\"],\"value\":\"a\"},{\"index\":[\"o2\"],\"value\":\"b\"},{\"index\":[\"o3\"],\"value\":\"a\"},{\"index\":[\"o4\"],\"value\":\"b\"},{\"index\":[\"o5\"],\"value\":\"a\"},{\"index\":[\"o6\"],\"value\":\"b\"}]},\"description\":null},{\"name\":\"qty\",\"type\":{\"kind\":\"int\",\"min\":1,\"max\":4},\"index\":[\"orders\"],\"value\":{\"default\":null,\"cells\":[{\"index\":[\"o1\"],\"value\":2},{\"index\":[\"o2\"],\"value\":1},{\"index\":[\"o3\"],\"value\":3},{\"index\":[\"o4\"],\"value\":2},{\"index\":[\"o5\"],\"value\":1},{\"index\":[\"o6\"],\"value\":3}]},\"description\":null},{\"name\":\"arrive_at\",\"type\":{\"kind\":\"int\",\"min\":0,\"max\":24},\"index\":[\"orders\"],\"value\":{\"default\":null,\"cells\":[{\"index\":[\"o1\"],\"value\":0},{\"index\":[\"o2\"],\"value\":0},{\"index\":[\"o3\"],\"value\":0},{\"index\":[\"o4\"],\"value\":2},{\"index\":[\"o5\"],\"value\":3},{\"index\":[\"o6\"],\"value\":4}]},\"description\":null},{\"name\":\"due\",\"type\":{\"kind\":\"int\",\"min\":0,\"max\":24},\"index\":[\"orders\"],\"value\":{\"default\":null,\"cells\":[{\"index\":[\"o1\"],\"value\":6},{\"index\":[\"o2\"],\"value\":7},{\"index\":[\"o3\"],\"value\":9},{\"