stateDiagram-v2
    %% credential_issuance_rotation — one-time credential issuance & periodic rotation (replay / idempotency)
    [*] --> no_credential
    no_credential --> request_pending: receive_request
    request_pending --> credential_minted: receive_valid_proof
    credential_minted --> credential_active: activate_credential
    credential_active --> rotation_pending: receive_rotation_request
    rotation_pending --> rotation_active: activate_rotation
    request_pending --> request_pending: receive_request
    credential_active --> request_pending: receive_request
    rotation_active --> request_pending: receive_request
    credential_active --> credential_counter_reset: replay_issuance_proof
    rotation_active --> credential_counter_reset: replay_rotation_request
    credential_counter_reset --> [*]
    class credential_counter_reset bad
    classDef bad fill:#d7263d,color:#fff,stroke:#8b0000;